# Local development database.
# `npm run db:start` brings up a real PostgreSQL on this port; any Postgres works too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bioassetpro"
PORT=3001

# Session signing secret. REQUIRED — the API refuses to start without it, and
# there is deliberately no default: a fallback that silently works in
# development is a fallback that silently ships.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# How long a session lasts before signing in again. Optional; defaults to 12h.
# JWT_EXPIRES_IN="12h"

# Where the browser reaches the API. Optional; defaults to the value below.
# NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Sign-in providers. Both are OPTIONAL and both are off unless set: the sign-in
# screen asks the API which providers are configured and renders no button for
# one that is not, rather than showing a button that leads to a broken consent
# screen. Each needs an application registered under your own developer account.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# Real email, through Resend (https://resend.com). OPTIONAL — without it,
# "forgot password" falls back to an administrator generating a link from
# Staff & roles and sending it manually. RESEND_FROM_EMAIL must be an address
# on a domain you've verified in Resend, e.g. "BioAssetPro <noreply@yourfarm.com>" —
# their shared onboarding@resend.dev sender only delivers to your own account
# email, which is fine for trying this out but not for real users.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""

# Where the web app is reached — used to build the link inside a reset email.
# Optional; defaults to the value below.
# APP_URL="http://localhost:3000"
