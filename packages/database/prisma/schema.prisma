// BioAssetPro — Core Platform (Phase 1)
//
// HARD RULES ENCODED HERE:
//  1. All monetary values are BigInt, in the smallest currency unit (kobo for NGN).
//     There is no Float or unconstrained Decimal on any amount column, anywhere.
//  2. Posted rows are immutable. Enforced by Postgres triggers (see
//     prisma/sql/010_immutability.sql), not only by application code.
//  3. Every GL line carries the full Enterprise Dimension set (Consolidated
//     Reference §1.1). The mandatory six are NOT NULL at the database level.
//  8. Nothing species-specific appears here. Rates, mappings and requirement
//     flags are configuration rows, not constants.
//
// NOTE ON THE DIMENSION BLOCK: the mandatory six (company, branch, financial
// year, financial period, currency, exchange rate) are denormalised onto
// JournalLine as well as JournalEntry. That redundancy is deliberate — it keeps
// the trial balance and every dimensional report a flat indexed scan with no
// join to the header. That flatness is the whole reason we chose embedded FK
// columns over a normalised DimensionSet.
//
// Business dimensions (Customer, Supplier, Employee, Item) and the biological
// Batch dimension are NOT in this phase. They arrive with their master tables in
// Phase 4 and Phase 5 respectively, as nullable additive columns.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// A governed financial-statement placement for an account (US-897-002),
/// distinct from `AccountType`: type says asset-vs-liability-vs-equity-etc,
/// this says where within a statement it sits — current vs non-current, cost
/// of sales vs operating expense. Nullable and not yet read by any report:
/// Balance Sheet and Profit & Loss still use their own stated account-number
/// conventions (COST_OF_SALES_ACCOUNTS, the ASSET/LIABILITY/EQUITY partition)
/// rather than this field, so that migrating them is a deliberate, separate
/// change and setting this value can never silently move a live line.
enum FsCategory {
  CURRENT_ASSET
  NON_CURRENT_ASSET
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
  ARCHIVED
}

/// Phase 1 posts Draft -> Posted directly through the PostingService.
/// Phase 2 inserts the full workflow machine (SUBMITTED, UNDER_REVIEW,
/// APPROVED, RETURNED, REJECTED, CANCELLED) in front of POSTED. The posting
/// service contract does not change when it does.
///
/// There is deliberately no REVERSED status. A posted journal is immutable, so
/// it can never be moved to one. "Is this journal reversed?" is answered by the
/// existence of `reversedBy` — a separate document that itself went through the
/// full posting pipeline (Rule 2).
enum JournalStatus {
  DRAFT
  POSTED
}

enum WarehouseType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOODS
  BY_PRODUCT
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  RETURN
  CANCEL
  POST
  REVERSE
  PERIOD_OPEN
  PERIOD_SOFT_CLOSE
  PERIOD_CLOSE
  PERIOD_REOPEN
  LOGIN
  CONFIG_CHANGE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  /// The tenant this person belongs to. Every company-scoped query resolves it
  /// from here rather than from anything the client sends — without it there is
  /// no way to tell "which company is this user allowed to see" apart from
  /// "which company did the request ask for", which is not a distinction the
  /// server can afford to leave to the caller.
  ///
  /// Nullable only so that a platform administrator can exist without belonging
  /// to a tenant. That is deliberately NOT a skeleton key: a null company means
  /// no company-scoped data resolves at all, so the failure mode of forgetting
  /// to set it is an empty screen rather than every tenant's ledger.
  companyId    String?  @map("company_id") @db.Uuid
  /// Role codes, e.g. ADMINISTRATOR, FINANCE_MANAGER, FINANCIAL_CONTROLLER.
  /// Approval routing (Phase 2) resolves against these.
  roles        String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company? @relation("CompanyUsers", fields: [companyId], references: [id])

  createdJournals           JournalEntry[]             @relation("JournalCreatedBy")
  postedJournals            JournalEntry[]             @relation("JournalPostedBy")
  auditRecords              AuditRecord[]
  workflowMade              WorkflowTransaction[]      @relation("WorkflowMaker")
  workflowStepsActed        WorkflowTransactionStep[]  @relation("StepActor")
  workflowStepsOnBehalf     WorkflowTransactionStep[]  @relation("StepDelegator")
  workflowHistory           WorkflowHistory[]          @relation("HistoryActor")
  workflowHistoryOnBehalf   WorkflowHistory[]          @relation("HistoryDelegator")
  delegationsGiven          WorkflowDelegation[]       @relation("Delegator")
  delegationsReceived       WorkflowDelegation[]       @relation("Delegate")
  delegationsCreated        WorkflowDelegation[]       @relation("DelegationCreator")
  workflowComments          WorkflowComment[]          @relation("CommentAuthor")
  workflowNotifications     WorkflowNotification[]     @relation("NotificationRecipient")
  workflowAttachments       WorkflowAttachment[]       @relation("AttachmentUploader")
  taxPeriodsFiled           TaxPeriod[]                @relation("TaxPeriodFiler")
  taxAdjustments            TaxAdjustment[]            @relation("TaxAdjustmentCreator")
  employeeDocumentsUploaded EmployeeDocument[]         @relation("EmployeeDocumentUploader")
  recipeVersionsApproved    ProductRecipeVersion[]     @relation("RecipeApprover")
  manualJournalsCreated     ManualJournal[]            @relation("ManualJournalCreator")
  manualJournalAttachments  ManualJournalAttachment[]  @relation("ManualJournalAttachmentUploader")
  recurringJournalsCreated  RecurringJournal[]         @relation("RecurringJournalCreator")
  payrollRunsCreated        PayrollRun[]               @relation("PayrollRunCreator")
  quotationsCreated         SalesQuotation[]           @relation("QuotationCreator")
  quotationsSold            SalesQuotation[]           @relation("QuotationSalesperson")
  salesOrdersCreated        SalesOrder[]               @relation("SalesOrderCreator")
  deliveriesCreated         DeliveryNote[]             @relation("DeliveryCreator")
  invoicesCreated           SalesInvoice[]             @relation("InvoiceCreator")
  receiptsCreated           CustomerReceipt[]          @relation("ReceiptCreator")
  creditNotesCreated        CreditNote[]               @relation("CreditNoteCreator")
  requisitionsRequested     PurchaseRequisition[]      @relation("RequisitionRequester")
  rfqsCreated               Rfq[]                      @relation("RfqCreator")
  purchaseOrdersCreated     PurchaseOrder[]            @relation("PurchaseOrderCreator")
  grnsCreated               GoodsReceiptNote[]         @relation("GrnCreator")
  grnsInspected             GoodsReceiptNote[]         @relation("GrnInspector")
  supplierInvoicesCreated   SupplierInvoice[]          @relation("SupplierInvoiceCreator")
  supplierPaymentsCreated   SupplierPayment[]          @relation("PaymentCreator")
  checklistsCompleted       PeriodCloseChecklist[]     @relation("ChecklistCompleter")
  periodCloseLogs           PeriodCloseLog[]           @relation("CloseLogActor")
  reopenRequested           PeriodReopenRequest[]      @relation("ReopenRequester")
  reopenApproved            PeriodReopenRequest[]      @relation("ReopenApprover")
  dailyRecordsRecorded      DailyRecord[]              @relation("DailyRecordRecorder")
  treatmentsRecorded        TreatmentRecord[]          @relation("TreatmentRecorder")
  harvestsRecorded          HarvestRecord[]            @relation("HarvestRecorder")
  stageChangesRecorded      StageChange[]              @relation("StageChangeRecorder")
  invitationsSent           Invitation[]               @relation("InvitationSender")
  valuationsPrepared        BiologicalAssetValuation[] @relation("ValuationPreparer")
  fixedAssetsCapitalised    FixedAsset[]               @relation("FixedAssetCapitaliser")
  depreciationRunsCreated   DepreciationRun[]          @relation("DepreciationRunCreator")
  marketPricesCreated       MarketPriceList[]
  payrollPaymentsCreated    PayrollPayment[]           @relation("PayrollPaymentCreator")
  roleSectionAccessChanges  RoleSectionAccess[]
  productionOrdersCreated   ProductionOrder[]          @relation("ProductionOrderCreator")
  inventoryTransfersCreated InventoryTransfer[]
  inventoryWriteOffsCreated InventoryWriteOff[]

  @@map("users")
}

