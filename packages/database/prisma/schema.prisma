// ---------------------------------------------------------------------------
// General Ledger
// ---------------------------------------------------------------------------

model JournalEntry {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  journalNumber String        @map("journal_number")
  journalDate   DateTime      @map("journal_date") @db.Date
  narration     String
  status        JournalStatus @default(DRAFT)

  /// Where this journal came from. Every module posts through the same service,
  /// so this is how a GL line is traced back to its source document — and,
  /// with sourceDocumentId, how the source document finds its journal
  /// (both directions, per SnailPro TDD §10.5).
  sourceModule       String  @map("source_module")
  sourceDocumentType String  @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id")

  // Mandatory enterprise dimensions (header level)
  branchId          String  @map("branch_id") @db.Uuid
  financialYearId   String  @map("financial_year_id") @db.Uuid
  financialPeriodId String  @map("financial_period_id") @db.Uuid
  currencyId        String  @map("currency_id") @db.Uuid
  exchangeRate      Decimal @map("exchange_rate") @db.Decimal(18, 8)

  /// Set when this journal reverses another. The reversed journal is never
  /// mutated — reversal is a new document (Rule 2).
  reversalOfId String? @unique @map("reversal_of_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedById  String?   @map("posted_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company                   Company                    @relation(fields: [companyId], references: [id])
  branch                    Branch                     @relation(fields: [branchId], references: [id])
  financialYear             FinancialYear              @relation(fields: [financialYearId], references: [id])
  financialPeriod           FinancialPeriod            @relation(fields: [financialPeriodId], references: [id])
  currency                  Currency                   @relation(fields: [currencyId], references: [id])
  createdBy                 User                       @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedBy                  User?                      @relation("JournalPostedBy", fields: [postedById], references: [id])
  reversalOf                JournalEntry?              @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy                JournalEntry?              @relation("JournalReversal")
  lines                     JournalLine[]
  workflowTransactions      WorkflowTransaction[]
  vatRegisterEntries        VatRegisterEntry[]
  whtRegisterEntries        WhtRegisterEntry[]
  taxAdjustments            TaxAdjustment[]
  manualJournals            ManualJournal[]
  payrollRuns               PayrollRun[]
  stockMovements            StockMovement[]
  deliveryNotes             DeliveryNote[]
  salesInvoices             SalesInvoice[]
  customerReceipts          CustomerReceipt[]
  creditNotes               CreditNote[]
  goodsReceiptNotes         GoodsReceiptNote[]
  supplierInvoices          SupplierInvoice[]
  supplierPayments          SupplierPayment[]
  payrollPayments           PayrollPayment[]
  accountBalances           AccountBalance[]
  feedIssues                FeedIssue[]                @relation("FeedIssueJournal")
  treatmentRecords          TreatmentRecord[]          @relation("TreatmentJournal")
  harvestRecords            HarvestRecord[]            @relation("HarvestJournal")
  mortalityRecords          MortalityRecord[]          @relation("MortalityJournal")
  stageChanges              StageChange[]              @relation("StageChangeJournal")
  biologicalAssetValuations BiologicalAssetValuation[]
  livestockDisposals        LivestockGroupDisposal[]   @relation("LivestockDisposalJournal")
  fixedAssetCapitalisations FixedAsset[]               @relation("FixedAssetCapitalisationJournal")
  depreciationRuns          DepreciationRun[]
  productionOrderLossEvents ProductionOrderLossEvent[]
  productionOrdersIssued      ProductionOrder[] @relation("ProductionOrderIssue")
  productionOrdersConverted   ProductionOrder[] @relation("ProductionOrderConversion")
  productionOrdersCompleted   ProductionOrder[] @relation("ProductionOrderCompletion")
  productionOrdersSettled     ProductionOrder[] @relation("ProductionOrderSettlement")
  inventoryTransfersIssued  InventoryTransfer[] @relation("InventoryTransferIssue")
  inventoryTransfersReceived InventoryTransfer[] @relation("InventoryTransferReceipt")
  inventoryWriteOffs        InventoryWriteOff[]

  @@unique([companyId, journalNumber])
  @@index([companyId, financialPeriodId, status])
  @@index([sourceModule, sourceDocumentType, sourceDocumentId])
  @@map("journal_entries")
}

model JournalLine {
  id             String @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  lineNumber     Int    @map("line_number")
  glAccountId    String @map("gl_account_id") @db.Uuid
  description    String

  /// MONEY. Integer minor units (kobo). Exactly one of these is non-zero on
  /// any given line; both are non-negative. Enforced by CHECK constraint.
  debitKobo  BigInt @default(0) @map("debit_kobo")
  creditKobo BigInt @default(0) @map("credit_kobo")

  // --- Enterprise Dimensions §1.1 : MANDATORY (NOT NULL at DB level) ---
  companyId         String  @map("company_id") @db.Uuid
  branchId          String  @map("branch_id") @db.Uuid
  financialYearId   String  @map("financial_year_id") @db.Uuid
  financialPeriodId String  @map("financial_period_id") @db.Uuid
  currencyId        String  @map("currency_id") @db.Uuid
  exchangeRate      Decimal @map("exchange_rate") @db.Decimal(18, 8)

  // --- Enterprise Dimensions §1.1 : MANAGEMENT (conditional) ---
  // Nullable in the schema; conditionally required at posting time by the
  // DimensionValidator, driven by GLAccount.requires* flags.
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  penHouseId   String? @map("pen_house_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccount       GLAccount       @relation(fields: [glAccountId], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])
  branch          Branch          @relation(fields: [branchId], references: [id])
  financialYear   FinancialYear   @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  costCentre      CostCentre?     @relation(fields: [costCentreId], references: [id])
  farm            Farm?           @relation(fields: [farmId], references: [id])
  penHouse        PenHouse?       @relation(fields: [penHouseId], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id])
  // --- Enterprise Dimensions §1.1 : BUSINESS (contextual) ---
  // Nullable by nature: a depreciation line has no customer, and a sales line
  // has no employee. Where a line DOES concern a party, this is what makes the
  // party ledger a view over the general ledger rather than a copy of it.
  customerId      String?         @map("customer_id") @db.Uuid
  supplierId      String?         @map("supplier_id") @db.Uuid
  employeeId      String?         @map("employee_id") @db.Uuid
  itemId          String?         @map("item_id") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  item     Item?     @relation(fields: [itemId], references: [id])

  @@unique([journalEntryId, lineNumber])
  // The trial balance index: flat scan, no join to the header.
  @@index([companyId, financialPeriodId, glAccountId])
  @@index([companyId, costCentreId, financialPeriodId])
  @@index([companyId, farmId, financialPeriodId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Idempotency  (Rule 6 — required on every posting endpoint)
// ---------------------------------------------------------------------------

/// A replayed request returns the original result instead of posting twice.
/// requestHash guards against key reuse with a different payload, which is a
/// caller bug we must surface rather than silently accept.
model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  key         String
  requestHash String   @map("request_hash")
  resultRef   String   @map("result_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Audit  (Rule 9 — immutable, never editable or deletable via any code path)
// ---------------------------------------------------------------------------

model AuditRecord {
  id            String      @id @default(uuid()) @db.Uuid
  /// The tenant the acting user belonged to at the moment this was written.
  ///
  /// Denormalised deliberately. Reading it back through the user would mean a
  /// person who later moves between companies drags their entire history into
  /// the new one — and an audit trail whose contents depend on today's
  /// employment records is not evidence of anything. Stamped once, then
  /// immutable like the rest of the row.
  ///
  /// Nullable only because rows written before tenancy existed have no answer;
  /// those predate any company and are excluded from the company-scoped view.
  companyId     String?     @map("company_id") @db.Uuid
  /// The business transaction this record describes (e.g. a journal id).
  transactionId String      @map("transaction_id")
  module        String
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id")
  status        String
  action        AuditAction
  userId        String      @map("user_id") @db.Uuid
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  ipAddress     String?     @map("ip_address")
  device        String?
  comments      String?
  metadata      Json?

  /// What the field(s) held before and after the change (US-897-036) —
  /// dedicated columns rather than another key inside `metadata`, so "what did
  /// this used to say" is a real, queryable shape instead of whatever a caller
  /// happened to name that key. Populated at the call sites this session
  /// actually touches; not a retrofit of every existing AuditService.write()
  /// call across the app.
  oldValueJson Json? @map("old_value_json")
  newValueJson Json? @map("new_value_json")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([transactionId])
  @@index([module, entityType, entityId])
  @@index([occurredAt])
  @@index([companyId, occurredAt])
  @@map("audit_records")
}

/// Narrows which of an existing role's sections are visible, without a
/// deploy (US-897-035). Absence of a row means "as coded" — every role's
/// default reach is still `apps/web/src/lib/permissions.ts`'s own BY_ROLE
/// table, which stays the single source of truth for what a role can reach
/// AT ALL; this table can only turn a candidate section OFF for a role that
/// already has it, never grant one the code has no screen for. The role
/// enum itself is not extensible here — a company cannot invent a role, only
/// dial back the reach of one that already exists.
model RoleSectionAccess {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  role    String
  section String
  enabled Boolean @default(true)

  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  updatedBy User    @relation(fields: [updatedById], references: [id])

  @@unique([companyId, role, section])
  @@map("role_section_access")
}

// ---------------------------------------------------------------------------
// Workflow & Approval Engine  (Consolidated Reference §2 — Phase 2)
//
// Rule 5: ONE engine. Procurement, Sales, Payroll, Processing and Period Close
// register their transaction types here rather than implementing approvals
// themselves. Nothing in this section names a module or a species.
//
// Rule 4: maker-checker is structural. `makerId` is on the transaction and the
// service layer refuses an approval from that user — including when they hold
// the required role, and including when they arrive through a delegation.
// ---------------------------------------------------------------------------

/// Consolidated Reference §2. The alternate paths (Rejected, Returned,
/// Cancelled) are terminal-or-resumable states, not a separate machine.
///
///   DRAFT -> SUBMITTED -> UNDER_REVIEW -> APPROVED -> POSTED -> CLOSED
///   SUBMITTED/UNDER_REVIEW -> REJECTED
///   SUBMITTED/UNDER_REVIEW -> RETURNED -> (maker edits) -> SUBMITTED
///   DRAFT -> CANCELLED
enum WorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  CLOSED
  REJECTED
  RETURNED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum WorkflowActionType {
  SUBMIT
  APPROVE
  REJECT
  RETURN
  RESUBMIT
  CANCEL
  DELEGATE
  ESCALATE
  REMIND
  POST
  CLOSE
  COMMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationEvent {
  SUBMISSION
  APPROVAL
  REJECTION
  RETURN
  ESCALATION
  REMINDER
  CANCELLATION
  POSTING
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// A routing rule: for this transaction type, in this scope, use these steps.
///
/// Scope columns are all nullable. A null means "any" — so a definition with
/// every scope column null is the company-wide default, and one naming a branch
/// and a cost centre is more specific. Resolution picks the most specific match
/// (see WorkflowRoutingService), which is what lets a farm run a tighter ladder
/// than head office without duplicating the whole configuration.
///
/// Effective-dated (Rule 8). Changing an approval ladder never edits history;
/// it closes one definition and opens another.
model WorkflowDefinition {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  /// Registered key, e.g. MANUAL_JOURNAL, PURCHASE_ORDER, PAYROLL_RUN.
  transactionType String  @map("transaction_type")
  name            String
  description     String?

  // --- scope (null = matches anything) ---
  branchId     String? @map("branch_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  currencyId   String? @map("currency_id") @db.Uuid

  /// When true, reaching final approval hands the pinned payload to the
  /// registered posting handler. When false, approval is the end state and the
  /// owning module posts on its own schedule.
  autoPostOnApproval Boolean @default(false) @map("auto_post_on_approval")

  active        Boolean   @default(true)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id])
  branch       Branch?               @relation(fields: [branchId], references: [id])
  farm         Farm?                 @relation(fields: [farmId], references: [id])
  department   Department?           @relation(fields: [departmentId], references: [id])
  costCentre   CostCentre?           @relation(fields: [costCentreId], references: [id])
  currency     Currency?             @relation(fields: [currencyId], references: [id])
  steps        WorkflowStep[]
  transactions WorkflowTransaction[]

  @@index([companyId, transactionType, active])
  @@map("workflow_definitions")
}

/// One rung of an approval ladder. Levels are unlimited and configurable (§2).
///
/// `maxAmountKobo` is this rung's approval ceiling, NOT a band floor. A
/// transaction requires every step from level 1 up to and including the first
/// whose ceiling covers the amount; null means unlimited and therefore always
/// terminates the chain. The consultant's example ladder
/// (Farm Manager 250k -> Finance Manager 2m -> Controller 10m -> MD above)
/// expresses exactly this, and it is why a 5m transaction collects four
/// approvals rather than only the Controller's.
model WorkflowStep {
  id            String  @id @default(uuid()) @db.Uuid
  definitionId  String  @map("definition_id") @db.Uuid
  level         Int
  /// Role code required to act, matched against User.roles.
  roleCode      String  @map("role_code")
  name          String
  maxAmountKobo BigInt? @map("max_amount_kobo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, level])
  @@map("workflow_steps")
}

/// A document under approval. One row per module document, created at submit.
model WorkflowTransaction {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  transactionType   String @map("transaction_type")
  module            String
  documentType      String @map("document_type")
  /// The owning module's own primary key for the document.
  documentId        String @map("document_id")
  /// Human-readable reference shown in queues and audit records.
  documentReference String @map("document_reference")

  /// MONEY. Routing input. Zero where the type is not amount-driven.
  amountKobo BigInt @default(0) @map("amount_kobo")

  // --- routing dimensions ---
  currencyId   String  @map("currency_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid

  /// Pinned at submit. Config may change afterwards; this transaction's ladder
  /// does not, because an approval chain that mutates under a pending document
  /// cannot be audited.
  definitionId String @map("definition_id") @db.Uuid

  status       WorkflowStatus @default(DRAFT)
  /// The level currently awaiting action. Null once terminal.
  currentLevel Int?           @map("current_level")

  /// Rule 4. The user who created or last edited the document. Never eligible
  /// to approve it, by any route.
  makerId String @map("maker_id") @db.Uuid

  /// Opaque to the engine. When the definition auto-posts, this is handed to
  /// the handler registered for the transaction type.
  postingPayload Json? @map("posting_payload")

  /// Set once posting succeeds, linking workflow to ledger in both directions.
  journalEntryId String? @map("journal_entry_id") @db.Uuid

  submittedAt       DateTime? @map("submitted_at")
  completedAt       DateTime? @map("completed_at")
  /// When the current level began waiting — the clock escalation reads.
  levelEnteredAt    DateTime? @map("level_entered_at")
  lastReminderAt    DateTime? @map("last_reminder_at")
  managerNotifiedAt DateTime? @map("manager_notified_at")
  escalatedAt       DateTime? @map("escalated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                   Company                    @relation(fields: [companyId], references: [id])
  currency                  Currency                   @relation(fields: [currencyId], references: [id])
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  farm                      Farm?                      @relation(fields: [farmId], references: [id])
  department                Department?                @relation(fields: [departmentId], references: [id])
  costCentre                CostCentre?                @relation(fields: [costCentreId], references: [id])
  definition                WorkflowDefinition         @relation(fields: [definitionId], references: [id])
  maker                     User                       @relation("WorkflowMaker", fields: [makerId], references: [id])
  journalEntry              JournalEntry?              @relation(fields: [journalEntryId], references: [id])
  steps                     WorkflowTransactionStep[]
  history                   WorkflowHistory[]
  comments                  WorkflowComment[]
  notifications             WorkflowNotification[]
  attachments               WorkflowAttachment[]
  biologicalAssetValuations BiologicalAssetValuation[]

  @@unique([module, documentType, documentId])
  @@index([companyId, status])
  @@index([status, currentLevel])
  @@map("workflow_transactions")
}

/// The frozen approval ladder for one transaction, snapshotted at submit.
model WorkflowTransactionStep {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @map("transaction_id") @db.Uuid
  level         Int
  roleCode      String             @map("role_code")
  name          String
  maxAmountKobo BigInt?            @map("max_amount_kobo")
  status        WorkflowStepStatus @default(PENDING)

  actedById         String?   @map("acted_by_id") @db.Uuid
  actedAt           DateTime? @map("acted_at")
  comments          String?
  /// Set when the acting user came through a delegation rather than the role.
  actedOnBehalfOfId String?   @map("acted_on_behalf_of_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transaction     WorkflowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actedBy         User?               @relation("StepActor", fields: [actedById], references: [id])
  actedOnBehalfOf User?               @relation("StepDelegator", fields: [actedOnBehalfOfId], references: [id])

  @@unique([transactionId, level])
  @@map("workflow_transaction_steps")
}

/// Every workflow event, append-only. Mirrors into AuditRecord (Rule 9); this
/// table is the workflow-shaped view, AuditRecord the system-wide one.
model WorkflowHistory {
  id            String             @id @default(uuid()) @db.Uuid
  transactionId String             @map("transaction_id") @db.Uuid
  action        WorkflowActionType
  fromStatus    WorkflowStatus?    @map("from_status")
  toStatus      WorkflowStatus     @map("to_status")
  level         Int?
  userId        String             @map("user_id") @db.Uuid
  onBehalfOfId  String?            @map("on_behalf_of_id") @db.Uuid
  comments      String?
  ipAddress     String?            @map("ip_address")
  device        String?
  occurredAt    DateTime           @default(now()) @map("occurred_at")

  transaction WorkflowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User                @relation("HistoryActor", fields: [userId], references: [id])
  onBehalfOf  User?               @relation("HistoryDelegator", fields: [onBehalfOfId], references: [id])

  @@index([transactionId, occurredAt])
  @@map("workflow_history")
}

/// §2 Delegation. All four documented fields plus the audit of who set it up.
///
/// A delegation lends authority, never identity: the delegate acts as
/// themselves, and Rule 4 still refuses them if they are the maker.
model WorkflowDelegation {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  delegatorId     String  @map("delegator_id") @db.Uuid
  delegateId      String  @map("delegate_id") @db.Uuid
  /// Null = every transaction type.
  transactionType String? @map("transaction_type")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String
  active    Boolean  @default(true)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id])
  delegator User    @relation("Delegator", fields: [delegatorId], references: [id])
  delegate  User    @relation("Delegate", fields: [delegateId], references: [id])
  createdBy User    @relation("DelegationCreator", fields: [createdById], references: [id])

  @@index([companyId, delegateId, active])
  @@map("workflow_delegations")
}

/// §2 Escalation thresholds. Configurable, per company and optionally per
/// transaction type. The documented 24/48/72 hours are seed data, not code.
model WorkflowEscalationRule {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  transactionType String? @map("transaction_type")

  remindAfterHours        Int @default(24) @map("remind_after_hours")
  notifyManagerAfterHours Int @default(48) @map("notify_manager_after_hours")
  escalateAfterHours      Int @default(72) @map("escalate_after_hours")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, transactionType])
  @@map("workflow_escalation_rules")
}

model WorkflowComment {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  transaction WorkflowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User                @relation("CommentAuthor", fields: [userId], references: [id])

  @@index([transactionId, createdAt])
  @@map("workflow_comments")
}

/// Outbox. Rows are written in the same transaction as the event that caused
/// them, so a notification can never describe an approval that rolled back.
/// Delivery is a separate, retryable concern.
model WorkflowNotification {
  id            String              @id @default(uuid()) @db.Uuid
  transactionId String              @map("transaction_id") @db.Uuid
  recipientId   String              @map("recipient_id") @db.Uuid
  channel       NotificationChannel
  event         NotificationEvent
  subject       String
  body          String
  status        NotificationStatus  @default(PENDING)
  sentAt        DateTime?           @map("sent_at")
  failureReason String?             @map("failure_reason")
  createdAt     DateTime            @default(now()) @map("created_at")

  transaction WorkflowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recipient   User                @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, status])
  @@index([status, createdAt])
  @@map("workflow_notifications")
}

model WorkflowAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  byteSize      Int      @map("byte_size")
  storageKey    String   @map("storage_key")
  uploadedById  String   @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  transaction WorkflowTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploadedBy  User                @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([transactionId])
  @@map("workflow_attachments")
}

// ---------------------------------------------------------------------------
// Tax Engine — VAT & WHT  (Consolidated Reference §4 — Phase 3)
//
// Rule 5: ONE tax engine. Procurement, Sales and Banking call it; none of them
// computes tax itself. Rule 8: every rate, threshold and GL mapping is
// effective-dated configuration, never a constant in code — Nigerian rates
// change by Finance Act and must be correctable without a deployment.
//
// A NOTE ON THE THREE TABLES §4 LISTS: the reference names TaxCode, VATCode and
// WHTCode. VATCode and WHTCode would share every column with TaxCode and differ
// only by which tax they describe, so they are one table here discriminated by
// `taxType`, with the rate history in TaxRate. Splitting them would mean two
// copies of the same effective-dating logic to keep in step. Everything §4 asks
// for is present; it is arranged in two tables rather than three.
// ---------------------------------------------------------------------------

enum TaxType {
  VAT
  WHT
}

/// Zero-rated and exempt both produce no tax, but they are not the same thing:
/// input VAT on zero-rated supplies is recoverable and on exempt supplies is
/// not. Collapsing them would misstate the VAT return, so the distinction is
/// carried explicitly rather than inferred from a zero rate.
enum TaxTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

enum VatDirection {
  /// VAT we paid a supplier. Recoverable unless the treatment says otherwise.
  INPUT
  /// VAT we charged a customer and owe to the authority.
  OUTPUT
}

enum WhtDirection {
  /// We withheld from a supplier and owe it to the authority.
  PAYABLE
  /// A customer withheld from us; claimable against our own tax.
  RECEIVABLE
}

enum TaxPeriodStatus {
  OPEN
  CLOSED
  FILED
}

/// Rounding is a policy decision with money consequences, so it is configuration
/// and it is explicit. HALF_UP is the Nigerian commercial convention.
enum RoundingRule {
  HALF_UP
  HALF_EVEN
  DOWN
  UP
}

/// Whether withholding is computed on the amount before or after VAT. This is
/// legally significant and the source documents do not state it, so it is
/// configuration with no silent default — see TaxConfiguration.
enum WhtBasis {
  NET_OF_VAT
  GROSS_INCLUDING_VAT
}

/// Whether a price already contains its VAT.
enum PriceBasis {
  EXCLUSIVE
  INCLUSIVE
}

/// The tax master. One row per code a document line can carry.
model TaxCode {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  taxType   TaxType @map("tax_type")

  treatment TaxTreatment @default(STANDARD)

  /// VAT only. Whether a price carrying this code already includes the tax.
  priceBasis PriceBasis @default(EXCLUSIVE) @map("price_basis")

  /// VAT only. Whether input VAT under this code may be recovered. Exempt
  /// supplies are the case where it may not.
  recoverable Boolean @default(true)

  /// WHT only. The §5/§6 "WHT Category" on the supplier and customer masters.
  /// Free text rather than an enum because the categories are set by the tax
  /// authority, not by this system.
  whtCategory String? @map("wht_category")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  rates                TaxRate[]
  glMappings           TaxGLMapping[]
  vatEntries           VatRegisterEntry[]
  whtEntries           WhtRegisterEntry[]
  adjustments          TaxAdjustment[]
  suppliers            Supplier[]            @relation("SupplierWhtCode")
  customers            Customer[]            @relation("CustomerWhtCode")
  items                Item[]                @relation("ItemVatCode")
  quotationLines       SalesQuotationLine[]  @relation("QuotationLineTaxCode")
  salesOrderLines      SalesOrderLine[]      @relation("SalesOrderLineTaxCode")
  salesInvoiceLines    SalesInvoiceLine[]    @relation("InvoiceLineTaxCode")
  creditNoteLines      CreditNoteLine[]      @relation("CreditNoteLineTaxCode")
  customerReceipts     CustomerReceipt[]     @relation("ReceiptWhtCode")
  purchaseOrderLines   PurchaseOrderLine[]   @relation("PurchaseOrderLineTaxCode")
  supplierInvoiceLines SupplierInvoiceLine[] @relation("SupplierInvoiceLineTaxCode")
  supplierInvoicesWht  SupplierInvoice[]     @relation("SupplierInvoiceWhtCode")
  supplierPaymentsWht  SupplierPayment[]     @relation("PaymentWhtCode")

  @@unique([companyId, code])
  @@index([companyId, taxType, active])
  @@map("tax_codes")
}

/// Effective-dated rate history for a tax code (Rule 8).
///
/// The rate is a Decimal, not money: it is a ratio, and it is the one place
/// fractional arithmetic is allowed. Every amount derived from it is rounded to
/// integer kobo exactly once, at the point of persistence (Rule 1).
model TaxRate {
  id        String  @id @default(uuid()) @db.Uuid
  taxCodeId String  @map("tax_code_id") @db.Uuid
  /// e.g. 0.07500000 for 7.5%.
  rate      Decimal @db.Decimal(9, 8)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Where the rate comes from — a Finance Act section, a circular, a URL.
  /// A tax rate with no provenance is not auditable.
  sourceReference String? @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  taxCode TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@index([taxCodeId, effectiveFrom])
  @@map("tax_rates")
}

/// Company-level tax policy. Everything here would otherwise be a constant
/// buried in the engine.
model TaxConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  rounding RoundingRule @default(HALF_UP)

  /// NOT defaulted to a guess. The source documents never state whether WHT is
  /// computed before or after VAT, and the two give different answers, so this
  /// is set deliberately per company and recorded with its authority below.
  whtBasis          WhtBasis @map("wht_basis")
  whtBasisAuthority String?  @map("wht_basis_authority")

  /// VAT registration details for the return.
  vatRegistrationNumber String? @map("vat_registration_number")
  tin                   String?

  /// Filing cadence in months; Nigerian VAT is monthly.
  vatFilingIntervalMonths Int @default(1) @map("vat_filing_interval_months")
  /// Day of the following month the return is due. Nigerian VAT is the 21st.
  vatFilingDueDayOfMonth  Int @default(21) @map("vat_filing_due_day_of_month")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, effectiveFrom])
  @@map("tax_configurations")
}

/// Which GL account each tax code posts to, in each direction. Effective-dated
/// because a chart of accounts is restructured more often than anyone expects.
model TaxGLMapping {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  taxCodeId String @map("tax_code_id") @db.Uuid

  /// INPUT/OUTPUT for VAT, PAYABLE/RECEIVABLE for WHT. Stored as text so one
  /// table serves both without a nullable enum per tax type.
  direction String

  glAccountId String @map("gl_account_id") @db.Uuid

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  taxCode   TaxCode   @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  glAccount GLAccount @relation(fields: [glAccountId], references: [id])

  @@index([companyId, taxCodeId, direction, effectiveFrom])
  @@map("tax_gl_mappings")
}

/// A filing period. Separate from the financial period because a VAT return
/// covers a calendar month with its own due date and its own close, and the two
/// calendars do not have to agree.
model TaxPeriod {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  taxType   TaxType @map("tax_type")

  year         Int
  periodNumber Int    @map("period_number")
  name         String

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  status TaxPeriodStatus @default(OPEN)

  filedAt         DateTime? @map("filed_at")
  filedById       String?   @map("filed_by_id") @db.Uuid
  filingReference String?   @map("filing_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company            @relation(fields: [companyId], references: [id])
  filedBy     User?              @relation("TaxPeriodFiler", fields: [filedById], references: [id])
  vatEntries  VatRegisterEntry[]
  whtEntries  WhtRegisterEntry[]
  adjustments TaxAdjustment[]

  @@unique([companyId, taxType, year, periodNumber])
  @@index([companyId, taxType, status])
  @@map("tax_periods")
}

/// One line of the VAT return, written in the same database transaction as the
/// GL posting that produced it.
///
/// That timing is the whole control: a register assembled later, by a separate
/// job reading the ledger, can drift from the ledger. One written alongside the
/// posting cannot — and the reconciliation test proves the totals still agree.
model VatRegisterEntry {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  taxPeriodId String       @map("tax_period_id") @db.Uuid
  taxCodeId   String       @map("tax_code_id") @db.Uuid
  direction   VatDirection
  treatment   TaxTreatment

  /// The document that gave rise to it.
  sourceModule       String   @map("source_module")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String?  @map("source_document_id")
  documentReference  String   @map("document_reference")
  documentDate       DateTime @map("document_date") @db.Date

  /// Counterparty as at the document date. Denormalised deliberately: a VAT
  /// return must reproduce what was filed, not what the master data says today.
  counterpartyName String? @map("counterparty_name")
  counterpartyTin  String? @map("counterparty_tin")

  /// MONEY. Integer kobo.
  taxableBaseKobo BigInt  @map("taxable_base_kobo")
  taxKobo         BigInt  @map("tax_kobo")
  /// The rate actually applied, kept so a historical line can be re-derived
  /// even after the rate changes.
  appliedRate     Decimal @map("applied_rate") @db.Decimal(9, 8)
  recoverable     Boolean @default(true)

  journalEntryId String @map("journal_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  taxPeriod    TaxPeriod    @relation(fields: [taxPeriodId], references: [id])
  taxCode      TaxCode      @relation(fields: [taxCodeId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([companyId, taxPeriodId, direction])
  @@index([journalEntryId])
  @@map("vat_register_entries")
}

/// One line of the WHT register.
///
/// WHT crystallises on the cash movement, not the invoice — §5 credits WHT
/// Payable at supplier payment and §6 debits WHT Receivable at customer
/// receipt. Entries are therefore written by the payment and receipt paths.
model WhtRegisterEntry {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  taxPeriodId String       @map("tax_period_id") @db.Uuid
  taxCodeId   String       @map("tax_code_id") @db.Uuid
  direction   WhtDirection
  whtCategory String       @map("wht_category")

  sourceModule       String   @map("source_module")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String?  @map("source_document_id")
  documentReference  String   @map("document_reference")
  documentDate       DateTime @map("document_date") @db.Date

  counterpartyName String? @map("counterparty_name")
  counterpartyTin  String? @map("counterparty_tin")

  /// MONEY. Integer kobo.
  grossAmountKobo BigInt  @map("gross_amount_kobo")
  vatAmountKobo   BigInt  @default(0) @map("vat_amount_kobo")
  /// What the rate was actually applied to, after the WhtBasis decision.
  taxableBaseKobo BigInt  @map("taxable_base_kobo")
  taxKobo         BigInt  @map("tax_kobo")
  appliedRate     Decimal @map("applied_rate") @db.Decimal(9, 8)

  /// The credit note the counterparty issues as evidence, needed to claim it.
  creditNoteReference String?   @map("credit_note_reference")
  creditNoteDate      DateTime? @map("credit_note_date") @db.Date

  journalEntryId String @map("journal_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  taxPeriod    TaxPeriod    @relation(fields: [taxPeriodId], references: [id])
  taxCode      TaxCode      @relation(fields: [taxCodeId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([companyId, taxPeriodId, direction])
  @@index([journalEntryId])
  @@map("wht_register_entries")
}

/// A correction to a filed or closed tax period. Workflow-governed, like every
/// other correction in this system — a register entry is never edited (Rule 2).
model TaxAdjustment {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  taxType   TaxType @map("tax_type")

  taxPeriodId String @map("tax_period_id") @db.Uuid
  taxCodeId   String @map("tax_code_id") @db.Uuid

  reference String
  reason    String

  /// MONEY. Signed: negative reduces the liability.
  taxableBaseKobo BigInt @map("taxable_base_kobo")
  taxKobo         BigInt @map("tax_kobo")

  /// Set once the adjustment has been approved and posted.
  journalEntryId String? @map("journal_entry_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  taxPeriod    TaxPeriod     @relation(fields: [taxPeriodId], references: [id])
  taxCode      TaxCode       @relation(fields: [taxCodeId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User          @relation("TaxAdjustmentCreator", fields: [createdById], references: [id])

  @@index([companyId, taxPeriodId])
  @@map("tax_adjustments")
}

// ---------------------------------------------------------------------------
// Master Data  (Consolidated Reference §5, §6, §7, §10 — Phase 4)
//
// Supplier, Customer, Item, Employee and Recipe/BOM. Everything downstream
// hangs off these, so two rules matter more here than anywhere else:
//
//   Rule 1  Every money field is BigInt kobo. Standard costs, credit limits and
//           salary components included. Quantities are Decimal — a quantity is
//           not money and 0.002 litres of preservative is a real BOM line.
//
//   Rule 8  Nothing species-specific. There is no snail table and no poultry
//           table: a recipe for cosmetic slime and a recipe for dressed chicken
//           are the same three rows with different configuration.
//
// The tax links (Item.vatTaxCodeId, Supplier/Customer.whtTaxCodeId) point at
// Phase 3's TaxCode. That is what makes Rule 5 real rather than aspirational —
// a document cannot carry a VAT rate that the tax engine does not own.
// ---------------------------------------------------------------------------

enum PartyStatus {
  ACTIVE
  INACTIVE
  /// §5/§6: a blocked party fails credit control and cannot transact at all.
  BLOCKED
}

/// §5 Item Master carries three independent Y/N flags (Inventory / Biological
/// Feed / Expense). Inventory and Expense are mutually exclusive in practice —
/// an item is either stocked or expensed on receipt — so they collapse into one
/// discriminator. "Biological Feed" is orthogonal to both and stays a flag.
enum ItemType {
  INVENTORY
  EXPENSE
  SERVICE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
  INTERN
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNDISCLOSED
}

/// §7 Payroll Setup. The three groups the payroll posting distinguishes:
/// earnings and deductions move the employee's net pay, employer contributions
/// are a company cost that never touches it.
enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum SalaryComponentBasis {
  /// A fixed monthly amount in kobo.
  FIXED
  /// A percentage of a named base (e.g. pension on basic+housing+transport).
  PERCENTAGE_OF_BASE
}

/// A recipe version's lifecycle. SUPERSEDED rather than deleted: a production
/// order from last quarter must still resolve the version it actually used.
enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

/// §5/§6 Payment Terms. A master rather than free text because a supplier
/// invoice needs a computed Due Date, and "30 days net" as a string cannot
/// produce one.
model PaymentTerm {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  code            String
  name            String
  /// Days from invoice date to due date.
  netDays         Int      @map("net_days")
  /// Optional early-settlement discount, e.g. 2% if paid within 10 days.
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  discountDays    Int?     @map("discount_days")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id])
  suppliers      Supplier[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@map("payment_terms")
}

/// Units of measure. No conversion factors: the source documents never define
/// any, and an invented conversion between kilogrammes and units would silently
/// mis-cost every recipe that used it.
model UnitOfMeasure {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code      String
  name      String
  /// Decimal places a quantity in this unit may carry. Whole units of packaging
  /// are not divisible; litres of slime are.
  precision Int    @default(3)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company                  @relation(fields: [companyId], references: [id])
  items      Item[]
  components ProductRecipeComponent[]

  @@unique([companyId, code])
  @@map("units_of_measure")
}

// ---------------------------------------------------------------------------
// §5 Supplier Master
// ---------------------------------------------------------------------------

model Supplier {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  category  String?

  // --- Tax identity ---
  tin                   String?
  vatRegistrationNumber String? @map("vat_registration_number")
  /// §5 "WHT Category". Points at a Phase 3 WHT TaxCode so the rate comes from
  /// the tax engine and nowhere else.
  whtTaxCodeId          String? @map("wht_tax_code_id") @db.Uuid

  // --- Contact ---
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  address       String?

  // --- Banking (for §5 Supplier Payment) ---
  bankName      String? @map("bank_name")
  accountNumber String? @map("account_number")
  accountName   String? @map("account_name")

  // --- Commercial ---
  paymentTermId   String? @map("payment_term_id") @db.Uuid
  /// MONEY. Integer kobo. Zero means no limit has been set, which is different
  /// from a limit of zero — see Supplier.creditLimitSet.
  creditLimitKobo BigInt  @default(0) @map("credit_limit_kobo")
  creditLimitSet  Boolean @default(false) @map("credit_limit_set")

  defaultCurrencyId   String  @map("default_currency_id") @db.Uuid
  branchId            String? @map("branch_id") @db.Uuid
  defaultCostCentreId String? @map("default_cost_centre_id") @db.Uuid

  status       PartyStatus @default(ACTIVE)
  /// Why a supplier was blocked. A block with no reason is not auditable.
  statusReason String?     @map("status_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  whtTaxCode         TaxCode?            @relation("SupplierWhtCode", fields: [whtTaxCodeId], references: [id])
  paymentTerm        PaymentTerm?        @relation(fields: [paymentTermId], references: [id])
  defaultCurrency    Currency            @relation(fields: [defaultCurrencyId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  defaultCostCentre  CostCentre?         @relation("SupplierCostCentre", fields: [defaultCostCentreId], references: [id])
  preferredForItems  Item[]              @relation("PreferredSupplier")
  journalLines       JournalLine[]
  manualJournals     ManualJournal[]
  manualJournalLines ManualJournalLine[]
  quotations         SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]
  goodsReceiptNotes  GoodsReceiptNote[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// §6 Customer Master
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  category  String?

  tin                   String?
  vatRegistrationNumber String? @map("vat_registration_number")
  /// The category the CUSTOMER withholds under when paying us — the mirror of
  /// the supplier field, and the source of §6's WHT Receivable.
  whtTaxCodeId          String? @map("wht_tax_code_id") @db.Uuid

  contactPerson String? @map("contact_person")
  telephone     String?
  email         String?
  address       String?
  state         String?
  country       String? @default("Nigeria")

  paymentTermId   String? @map("payment_term_id") @db.Uuid
  /// MONEY. Integer kobo. §6 Customer Credit Control checks against this.
  creditLimitKobo BigInt  @default(0) @map("credit_limit_kobo")
  creditLimitSet  Boolean @default(false) @map("credit_limit_set")

  currencyId          String  @map("currency_id") @db.Uuid
  defaultBranchId     String? @map("default_branch_id") @db.Uuid
  defaultCostCentreId String? @map("default_cost_centre_id") @db.Uuid

  status       PartyStatus @default(ACTIVE)
  statusReason String?     @map("status_reason")

  customerSince DateTime? @map("customer_since") @db.Date
  /// §6 "Risk Rating". Free text: the rating scale is the client's commercial
  /// policy, and inventing a fixed scale here would constrain it.
  riskRating    String?   @map("risk_rating")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  whtTaxCode         TaxCode?            @relation("CustomerWhtCode", fields: [whtTaxCodeId], references: [id])
  paymentTerm        PaymentTerm?        @relation(fields: [paymentTermId], references: [id])
  currency           Currency            @relation(fields: [currencyId], references: [id])
  defaultBranch      Branch?             @relation(fields: [defaultBranchId], references: [id])
  defaultCostCentre  CostCentre?         @relation("CustomerCostCentre", fields: [defaultCostCentreId], references: [id])
  journalLines       JournalLine[]
  manualJournals     ManualJournal[]
  manualJournalLines ManualJournalLine[]
  salesQuotations    SalesQuotation[]
  salesOrders        SalesOrder[]
  deliveryNotes      DeliveryNote[]
  salesInvoices      SalesInvoice[]
  customerReceipts   CustomerReceipt[]
  creditNotes        CreditNote[]
  salesReturns       SalesReturn[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// §5 Item / Product Master
// ---------------------------------------------------------------------------

model Item {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  code        String
  description String
  category    String?

  itemType         ItemType @default(INVENTORY) @map("item_type")
  /// §5 "Biological Feed (Y/N)" — orthogonal to itemType, and the flag that
  /// tells the Phase 5 biological module which purchases are feed consumption.
  isBiologicalFeed Boolean  @default(false) @map("is_biological_feed")
  /// Whether this item can be produced by a recipe (a finished good or an
  /// intermediate), as opposed to only ever being bought.
  isManufactured   Boolean  @default(false) @map("is_manufactured")

  unitOfMeasureId String @map("unit_of_measure_id") @db.Uuid

  /// §5 "VAT Code". A Phase 3 TaxCode of type VAT — the item never carries a
  /// rate of its own.
  vatTaxCodeId String? @map("vat_tax_code_id") @db.Uuid

  preferredSupplierId String? @map("preferred_supplier_id") @db.Uuid

  /// QUANTITIES, not money: Decimal, and never rounded to kobo.
  reorderLevel          Decimal? @map("reorder_level") @db.Decimal(18, 6)
  economicOrderQuantity Decimal? @map("economic_order_quantity") @db.Decimal(18, 6)

  /// Default GL accounts. Which one applies follows from itemType: an inventory
  /// item debits inventory on receipt, an expense item debits expense.
  inventoryGlAccountId String? @map("inventory_gl_account_id") @db.Uuid
  expenseGlAccountId   String? @map("expense_gl_account_id") @db.Uuid
  revenueGlAccountId   String? @map("revenue_gl_account_id") @db.Uuid

  defaultWarehouseId String? @map("default_warehouse_id") @db.Uuid

  /// The moving weighted-average cost per unit, across every warehouse —
  /// recomputed on each approved goods receipt (US-897-007) from the on-hand
  /// quantity and value just before that receipt lands, the same materialised-
  /// balance pattern LivestockGroup.population uses. Null until the item's
  /// first receipt. This is ACTUAL cost, distinct from ItemStandardCost's
  /// effective-dated PLANNED cost — nothing currently reads this one for
  /// consumption postings, which stay on standard cost unless the consuming
  /// document is one of the WAC-costed paths below.
  /// As of US-897-016's processing slice, this IS read for one consumption
  /// path — a production order's packaging issue (PCR-052) — via the shared
  /// `StockMovementService`. US-897-008's general inventory transfer/write-off
  /// (PCR-012–014) is a second: `InventoryTransfer`/`InventoryWriteOff` below.
  /// Sales delivery still stays on standard cost (§6's own basis).
  weightedAverageCostKobo  BigInt?   @map("weighted_average_cost_kobo")
  weightedAverageCostSetAt DateTime? @map("weighted_average_cost_set_at")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company       @relation(fields: [companyId], references: [id])
  unitOfMeasure      UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  vatTaxCode         TaxCode?      @relation("ItemVatCode", fields: [vatTaxCodeId], references: [id])
  preferredSupplier  Supplier?     @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  inventoryGlAccount GLAccount?    @relation("ItemInventoryAccount", fields: [inventoryGlAccountId], references: [id])
  expenseGlAccount   GLAccount?    @relation("ItemExpenseAccount", fields: [expenseGlAccountId], references: [id])
  revenueGlAccount   GLAccount?    @relation("ItemRevenueAccount", fields: [revenueGlAccountId], references: [id])
  defaultWarehouse   Warehouse?    @relation(fields: [defaultWarehouseId], references: [id])

  standardCosts          ItemStandardCost[]
  recipes                ProductRecipe[]           @relation("RecipeOutput")
  recipeComponents       ProductRecipeComponent[]
  journalLines           JournalLine[]
  manualJournalLines     ManualJournalLine[]
  stockMovements         StockMovement[]
  quotationLines         SalesQuotationLine[]
  salesOrderLines        SalesOrderLine[]
  deliveryLines          DeliveryNoteLine[]
  salesInvoiceLines      SalesInvoiceLine[]
  creditNoteLines        CreditNoteLine[]
  salesReturnLines       SalesReturnLine[]
  requisitionLines       PurchaseRequisitionLine[]
  quotationLinesSupplier SupplierQuotationLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceiptLines      GoodsReceiptNoteLine[]
  supplierInvoiceLines   SupplierInvoiceLine[]
  feedIssues             FeedIssue[]               @relation("FeedIssueItem")
  productionOrderComponents ProductionOrderComponent[]
  productionOrderOutputs    ProductionOrderOutput[]
  inventoryTransfers        InventoryTransfer[]
  inventoryWriteOffs        InventoryWriteOff[]

  @@unique([companyId, code])
  @@index([companyId, itemType, active])
  @@map("items")
}

/// §5 "Standard Cost", effective-dated (Rule 8).
///
/// Separate from Item because a standard cost changes and every past costing
/// must remain reproducible. The SnailPro BOM sheet's "Component Unit Cost"
/// column resolves through here.
model ItemStandardCost {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid

  /// MONEY. Integer kobo, per one unit of the item's UoM.
  standardCostKobo BigInt @map("standard_cost_kobo")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  sourceReference String? @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, effectiveFrom])
  @@map("item_standard_costs")
}

// ---------------------------------------------------------------------------
// §7 Employee Master
// ---------------------------------------------------------------------------

model Employee {
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @map("company_id") @db.Uuid
  employeeNumber String @map("employee_number")

  // --- Personal ---
  title         String?
  firstName     String         @map("first_name")
  middleName    String?        @map("middle_name")
  surname       String
  /// Free text rather than an enum. Gender categories are a policy question for
  /// the client's HR, and an enum here would force a choice this system has no
  /// business making.
  gender        String?
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  maritalStatus MaritalStatus? @map("marital_status")
  nationality   String?
  stateOfOrigin String?        @map("state_of_origin")
  address       String?
  email         String?
  phone         String?

  // --- Employment ---
  employmentType   EmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus EmploymentStatus @default(PROBATION) @map("employment_status")
  employmentDate   DateTime         @map("employment_date") @db.Date
  confirmationDate DateTime?        @map("confirmation_date") @db.Date
  exitDate         DateTime?        @map("exit_date") @db.Date

  departmentId       String? @map("department_id") @db.Uuid
  branchId           String? @map("branch_id") @db.Uuid
  /// §7.2 rejects a payroll posting with no cost centre, so this is the field
  /// that validation reads.
  costCentreId       String? @map("cost_centre_id") @db.Uuid
  designation        String?
  grade              String?
  jobCategory        String? @map("job_category")
  reportingManagerId String? @map("reporting_manager_id") @db.Uuid

  // --- Bank ---
  bankName      String? @map("bank_name")
  accountNumber String? @map("account_number")
  accountName   String? @map("account_name")

  // --- Statutory (drives Phase 9; see the payroll workbooks) ---
  tin                  String?
  nhfNumber            String? @map("nhf_number")
  pensionRsaNumber     String? @map("pension_rsa_number")
  pensionAdministrator String? @map("pension_administrator")
  /// PAYE is remitted per state of residence (PAYE workbook, PAYE_Summary).
  taxState             String? @map("tax_state")

  /// Enrolment flags, not rates. The rates live in Phase 9 configuration.
  /// NHF participation is opt-in for private-sector staff, so an absent flag
  /// means "do not deduct" rather than "deduct by default".
  pensionEnrolled Boolean @default(false) @map("pension_enrolled")
  nhfEnrolled     Boolean @default(false) @map("nhf_enrolled")

  // --- Next of kin ---
  nextOfKinName         String? @map("next_of_kin_name")
  nextOfKinRelationship String? @map("next_of_kin_relationship")
  nextOfKinPhone        String? @map("next_of_kin_phone")
  nextOfKinAddress      String? @map("next_of_kin_address")

  /// Set once HR has approved the record and payroll may include it (§7
  /// onboarding flow ends at "Payroll Activation").
  payrollActive Boolean @default(false) @map("payroll_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company     @relation(fields: [companyId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  branch           Branch?     @relation(fields: [branchId], references: [id])
  costCentre       CostCentre? @relation("EmployeeCostCentre", fields: [costCentreId], references: [id])
  reportingManager Employee?   @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  reports          Employee[]  @relation("ReportingLine")

  salaryComponents   EmployeeSalaryComponent[]
  documents          EmployeeDocument[]
  journalLines       JournalLine[]
  manualJournalLines ManualJournalLine[]
  taxReliefs         EmployeeTaxRelief[]
  payrollRunLines    PayrollRunLine[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, employmentStatus])
  @@map("employees")
}

/// §7 "Documents: Photo, Offer Letter, Contract, ID, CV, Certificates, Medical
/// Report". A table rather than a column per document, so adding a document
/// type is data.
model EmployeeDocument {
  id           String @id @default(uuid()) @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid
  documentType String @map("document_type")
  fileName     String @map("file_name")
  contentType  String @map("content_type")
  byteSize     Int    @map("byte_size")
  storageKey   String @map("storage_key")

  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("EmployeeDocumentUploader", fields: [uploadedById], references: [id])

  @@index([employeeId, documentType])
  @@map("employee_documents")
}

/// §7 Payroll Setup — the catalogue of components a company pays or deducts.
///
/// Every one of the §7 lists (Basic, Housing, Transport … PAYE, Pension, NHF …
/// Employer Pension, NSITF, ITF) is a row here, not a column anywhere. That is
/// what lets Phase 9 add a component without a migration.
model SalaryComponent {
  id        String               @id @default(uuid()) @db.Uuid
  companyId String               @map("company_id") @db.Uuid
  code      String
  name      String
  type      SalaryComponentType
  basis     SalaryComponentBasis @default(FIXED)

  /// Whether this earning forms part of taxable gross (PAYE workbook,
  /// Employee_Inputs: basic/housing/transport/other-taxable are summed).
  isTaxable           Boolean @default(true) @map("is_taxable")
  /// Whether it forms part of the pension base. The statutory workbook is
  /// explicit that the base is Basic + Housing + Transport, NOT gross — so this
  /// is a per-component flag rather than an assumption in the payroll engine.
  isPensionable       Boolean @default(false) @map("is_pensionable")
  /// Whether it forms part of the NHF base — the workbook's own formula
  /// (`NG_PAYE_2026!K5`) is `Basic x rate`, not gross. A per-component flag
  /// for the same reason `isPensionable` is one: NSITF genuinely does use
  /// gross (`isGrossPayComponent` below), and the two bases must not collapse
  /// into each other just because they are usually seeded together.
  isNhfBase           Boolean @default(false) @map("is_nhf_base")
  /// Whether it counts toward gross pay — the base NSITF and ITF use.
  isGrossPayComponent Boolean @default(true) @map("is_gross_pay_component")

  /// For PERCENTAGE_OF_BASE components: the rate, effective-dated on the
  /// assignment rather than here so a company-wide default can be overridden.
  defaultRate Decimal? @map("default_rate") @db.Decimal(9, 8)

  /// Where this component posts. §7 Payroll Accounting names an expense and a
  /// payable per component.
  expenseGlAccountId String? @map("expense_gl_account_id") @db.Uuid
  payableGlAccountId String? @map("payable_gl_account_id") @db.Uuid

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company                   @relation(fields: [companyId], references: [id])
  expenseGlAccount GLAccount?                @relation("SalaryComponentExpense", fields: [expenseGlAccountId], references: [id])
  payableGlAccount GLAccount?                @relation("SalaryComponentPayable", fields: [payableGlAccountId], references: [id])
  assignments      EmployeeSalaryComponent[]

  @@unique([companyId, code])
  @@map("salary_components")
}

/// What one employee is actually paid, effective-dated.
///
/// A salary change closes one row and opens another; it never edits an amount.
/// That is what makes a historical payroll run reproducible, which §7.1's audit
/// requirement ("store the exact rules and source values used") depends on.
model EmployeeSalaryComponent {
  id                String @id @default(uuid()) @db.Uuid
  employeeId        String @map("employee_id") @db.Uuid
  salaryComponentId String @map("salary_component_id") @db.Uuid

  /// MONEY. Integer kobo, for FIXED components.
  amountKobo BigInt?  @map("amount_kobo")
  /// For PERCENTAGE_OF_BASE components.
  rate       Decimal? @db.Decimal(9, 8)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_salary_components")
}

// ---------------------------------------------------------------------------
// §9/§10 Recipe / Bill of Materials
// ---------------------------------------------------------------------------

/// A recipe for producing an item. §10.1 names ProductionRecipe,
/// ProductionRecipeVersion and ProductionRecipeComponent, and the split matters:
/// a production order pins a VERSION (§10.2 `recipe_version_id`), so changing a
/// recipe can never rewrite what a past order consumed.
model ProductRecipe {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  code         String
  name         String
  /// The item this recipe produces.
  outputItemId String @map("output_item_id") @db.Uuid

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id])
  outputItem Item                   @relation("RecipeOutput", fields: [outputItemId], references: [id])
  versions   ProductRecipeVersion[]

  @@unique([companyId, code])
  @@index([companyId, outputItemId, active])
  @@map("product_recipes")
}

model ProductRecipeVersion {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  version  Int

  status RecipeVersionStatus @default(DRAFT)

  /// QUANTITY. What one run of this recipe yields, in the output item's UoM.
  /// Components are quantities PER THIS BATCH SIZE, not per single unit, so a
  /// recipe whose economics only work at scale can be expressed honestly.
  batchSize Decimal @map("batch_size") @db.Decimal(18, 6)

  /// §10 "Expected Yield %". The workbook's Production_Orders column E.
  expectedYieldPercent Decimal? @map("expected_yield_percent") @db.Decimal(9, 6)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipe     ProductRecipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  approvedBy User?                    @relation("RecipeApprover", fields: [approvedById], references: [id])
  components ProductRecipeComponent[]
  productionOrders ProductionOrder[]

  @@unique([recipeId, version])
  @@index([recipeId, status])
  @@map("product_recipe_versions")
}

model ProductRecipeComponent {
  id              String @id @default(uuid()) @db.Uuid
  recipeVersionId String @map("recipe_version_id") @db.Uuid
  lineNumber      Int    @map("line_number")
  componentItemId String @map("component_item_id") @db.Uuid

  /// QUANTITY per batch. Decimal(18,6) because 0.002 litres of preservative per
  /// bottle is a real line from the SnailPro BOM sheet, and rounding it to
  /// whole units would multiply the error by the batch size.
  quantityPerBatch Decimal @map("quantity_per_batch") @db.Decimal(18, 6)
  unitOfMeasureId  String  @map("unit_of_measure_id") @db.Uuid

  /// Expected process loss on this component, if any.
  wastagePercent Decimal? @map("wastage_percent") @db.Decimal(9, 6)

  /// Whether a shortage of this component blocks production or merely warns.
  optional Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipeVersion ProductRecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  componentItem Item                 @relation(fields: [componentItemId], references: [id])
  unitOfMeasure UnitOfMeasure        @relation(fields: [unitOfMeasureId], references: [id])

  @@unique([recipeVersionId, lineNumber])
  @@index([componentItemId])
  @@map("product_recipe_components")
}

// ---------------------------------------------------------------------------
// Production Orders — Processing (Consolidated Reference §9/§10 — Phase 6,
// US-897-016 through 020)
//
// One engine, two species: SnailPro processing (PCR-051–058, built first)
// and PoultryPro processing (PCR-074–080, the same eight-step shape against
// its own rule ids) — a population harvested, issued to processing, labour/
// overhead confirmed, joint outputs received into finished goods with cost
// split by the client's own approved NRV method, order settles with WIP at
// exactly zero. `ProductionOrderService`'s `SPECIES_PROCESSING_RULES` picks
// the right PCR ids from `LivestockGroup.speciesKey`; comments below cite
// SnailPro's numbers as the example since that path was built and
// live-verified first, not because the model is snail-specific.
//
// What an order actually consumes on its input side is NOT a recipe
// component — a live population is a biological asset (`LivestockGroup`),
// not an `Item`, so the issue step posts Dr WIP / Cr the population's own BA
// account, valued at its IAS 41 carrying value, exactly like every other
// biological-asset transfer this codebase already posts. `recipeVersionId`
// governs the PACKAGING components only — what an
// order draws from `Item` inventory via `StockMovement`, same as any other
// issue. This is a real, disclosed modelling compromise: `ProductRecipe`
// was built for one output per recipe, and a joint-output process does not
// fit that shape, so the packaging BOM still uses it (for costing/wastage)
// while the actual joint outputs are tracked here, independently, through
// `ProductionOrderOutput` and `CostAllocationService`.
// ---------------------------------------------------------------------------

enum ProductionOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RELEASED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

/// Which posting cycle this order runs — an explicit discriminator rather
/// than inferring from `sourceGroup.speciesKey`, which is null for
/// FEED_MILL orders (no biological population involved).
enum ProductionOrderCycle {
  SNAILPRO
  POULTRYPRO
  FEED_MILL
}

enum ProductionOrderOutputType {
  MAIN
  BY_PRODUCT
}

enum ProcessingLossClassification {
  NORMAL
  ABNORMAL
}

model ProductionOrder {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  farmId    String @map("farm_id") @db.Uuid

  /// The farm's own reference, same convention as PurchaseOrder/GRN numbers.
  orderNumber String @map("order_number")

  /// Governs the PACKAGING components only — see the file-level comment above.
  recipeVersionId String @map("recipe_version_id") @db.Uuid

  /// Where the population being processed comes from. Nullable only so an
  /// order can, in principle, be drafted before a harvest is linked — every
  /// order this pass actually creates comes from one.
  sourceGroupId String? @map("source_group_id") @db.Uuid

  /// The harvest this order processes. One order per harvest — a second
  /// processing run against the same harvest would double-count the WIP
  /// debit the issue step already posted.
  harvestRecordId String? @unique @map("harvest_record_id") @db.Uuid

  status ProductionOrderStatus @default(DRAFT)

  /// Which posting cycle this order runs — SnailPro/PoultryPro processing or
  /// Feed Mill manufacturing. Set once at creation; `ProductionOrderService`
  /// resolves every PCR rule id from this rather than from `sourceGroup`.
  processingCycle ProductionOrderCycle @default(SNAILPRO) @map("processing_cycle")

  /// QUANTITY of finished output planned, in the primary output item's UoM —
  /// what `RecipeService.explode()` scales the packaging BOM against.
  plannedOutputQuantity Decimal @map("planned_output_quantity") @db.Decimal(18, 6)

  /// MONEY. What the issue step debited WIP with — the source population's
  /// own carrying value at issue (PCR-051 for snail, PCR-074 for poultry),
  /// captured here because `LivestockGroup.currentFvlctsPerUnitKobo` keeps
  /// moving and Rule 7's identity needs this order's own frozen figure.
  biologicalInputValueKobo BigInt @default(0) @map("biological_input_value_kobo")

  /// MONEY. Packaging issued via the recipe explosion (PCR-052/075).
  packagingCostKobo BigInt @default(0) @map("packaging_cost_kobo")

  /// MONEY. PCR-053/076 — driver quantity × approved standard rate, absorbed
  /// into WIP against the recovery clearing account.
  standardConversionCostKobo BigInt @default(0) @map("standard_conversion_cost_kobo")

  /// MONEY. What labour and overhead actually cost, expensed directly rather
  /// than run through the recovery account. Snail posts these as two
  /// separate GL lines (PCR-054/055); poultry posts their sum as one
  /// combined line (PCR-077) — the split is still captured here either way,
  /// since settle()'s variance calculation only needs their total.
  actualLabourCostKobo    BigInt @default(0) @map("actual_labour_cost_kobo")
  actualOverheadCostKobo  BigInt @default(0) @map("actual_overhead_cost_kobo")

  /// MONEY. PCR-057/079 — the sum of every ProductionOrderOutput's allocated
  /// cost. Kept denormalised so Rule 7 can be asserted from the order row
  /// alone rather than re-summing its children every time.
  finishedGoodsCostKobo BigInt @default(0) @map("finished_goods_cost_kobo")

  /// MONEY. PCR-056/078 — abnormal processing loss written off WIP.
  abnormalLossCostKobo BigInt @default(0) @map("abnormal_loss_cost_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  /// Four posting moments, four journals — an order is not one transaction,
  /// it is a sequence of them (issue, packaging+conversion, loss+completion,
  /// settlement — PCR-051–058 for snail, PCR-074–080 for poultry), and
  /// Rule 7 is checked from these rather than by re-summing every child
  /// StockMovement each time.
  issueJournalEntryId      String? @map("issue_journal_entry_id") @db.Uuid
  conversionJournalEntryId String? @map("conversion_journal_entry_id") @db.Uuid
  completionJournalEntryId String? @map("completion_journal_entry_id") @db.Uuid
  settlementJournalEntryId String? @map("settlement_journal_entry_id") @db.Uuid

  releasedAt  DateTime? @map("released_at")
  issuedAt    DateTime? @map("issued_at")
  completedAt DateTime? @map("completed_at")
  settledAt   DateTime? @map("settled_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       Company              @relation(fields: [companyId], references: [id])
  branch        Branch               @relation(fields: [branchId], references: [id])
  farm          Farm                 @relation(fields: [farmId], references: [id])
  recipeVersion ProductRecipeVersion @relation(fields: [recipeVersionId], references: [id])
  sourceGroup   LivestockGroup?      @relation(fields: [sourceGroupId], references: [id])
  harvestRecord HarvestRecord?       @relation(fields: [harvestRecordId], references: [id])
  createdBy     User                 @relation("ProductionOrderCreator", fields: [createdById], references: [id])

  issueJournalEntry      JournalEntry? @relation("ProductionOrderIssue", fields: [issueJournalEntryId], references: [id])
  conversionJournalEntry JournalEntry? @relation("ProductionOrderConversion", fields: [conversionJournalEntryId], references: [id])
  completionJournalEntry JournalEntry? @relation("ProductionOrderCompletion", fields: [completionJournalEntryId], references: [id])
  settlementJournalEntry JournalEntry? @relation("ProductionOrderSettlement", fields: [settlementJournalEntryId], references: [id])

  components ProductionOrderComponent[]
  outputs    ProductionOrderOutput[]
  lossEvents ProductionOrderLossEvent[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@map("production_orders")
}

/// One packaging component, exploded from the recipe at release. Not the
/// market-snail input — see the model-group comment above.
model ProductionOrderComponent {
  id                String @id @default(uuid()) @db.Uuid
  productionOrderId String @map("production_order_id") @db.Uuid
  lineNumber        Int    @map("line_number")
  componentItemId   String @map("component_item_id") @db.Uuid

  plannedQuantity  Decimal @map("planned_quantity") @db.Decimal(18, 6)
  plannedCostKobo  BigInt  @map("planned_cost_kobo")

  /// Set once issued (PCR-052). Null beforehand — a component planned but
  /// not yet issued has no actual to report.
  issuedQuantity Decimal? @map("issued_quantity") @db.Decimal(18, 6)
  issuedCostKobo BigInt?  @map("issued_cost_kobo")
  stockMovementId String? @map("stock_movement_id") @db.Uuid

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentItem   Item            @relation(fields: [componentItemId], references: [id])
  stockMovement   StockMovement?  @relation(fields: [stockMovementId], references: [id])

  @@unique([productionOrderId, lineNumber])
  @@map("production_order_components")
}

/// One joint or by-product output, received at completion (PCR-057).
model ProductionOrderOutput {
  id                String                    @id @default(uuid()) @db.Uuid
  productionOrderId String                    @map("production_order_id") @db.Uuid
  itemId            String                    @map("item_id") @db.Uuid
  outputType        ProductionOrderOutputType @map("output_type")

  quantity Decimal @db.Decimal(18, 6)

  /// MONEY. The NRV (or other method's) weight this output was allocated
  /// against, kept for audit — "why did meat get 70% and shell 5%".
  allocationWeightKobo BigInt @map("allocation_weight_kobo")
  allocatedCostKobo    BigInt @map("allocated_cost_kobo")

  stockMovementId String? @map("stock_movement_id") @db.Uuid

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
  stockMovement   StockMovement?  @relation(fields: [stockMovementId], references: [id])

  @@index([productionOrderId])
  @@map("production_order_outputs")
}

/// Processing-yield loss (PCR-056) — the yield half of US-897-018, distinct
/// from the mortality half `MortalityRecord` already covers.
model ProductionOrderLossEvent {
  id                String                        @id @default(uuid()) @db.Uuid
  productionOrderId String                        @map("production_order_id") @db.Uuid
  quantity          Decimal                       @db.Decimal(18, 6)
  classification    ProcessingLossClassification
  costKobo          BigInt                        @map("cost_kobo")
  reason            String?
  journalEntryId    String?                       @map("journal_entry_id") @db.Uuid
  createdAt         DateTime                      @default(now()) @map("created_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@map("production_order_loss_events")
}

// ---------------------------------------------------------------------------
// General inventory: transfer and write-off (Consolidated Reference §14 —
// PCR-012/013/014, US-897-008)
//
// The production-order material-issue path already proved the negative-stock
// guard and WAC costing (StockMovementService); this is the SAME primitive
// reused for the two general-purpose movements the client's own approved
// posting-control JSON specifies outside any one document type: a transfer
// between warehouses (PCR-012 issue at source / PCR-013 receipt at
// destination — genuinely two steps, with an "Inventory in Transit" holding
// account between them, not a single move) and an approved write-off
// (PCR-014, abnormal loss/obsolete stock). A "return to source" is not a
// third concept — PCR-012's own reversal note reads "reverse transfer or
// return to source", so a return is just a new InventoryTransfer with the
// warehouses swapped, not a separate model.
// ---------------------------------------------------------------------------

enum InventoryTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model InventoryTransfer {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  /// The farm's own reference, same convention as every other document number.
  transferNumber String @map("transfer_number")

  itemId          String @map("item_id") @db.Uuid
  fromWarehouseId String @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String @map("to_warehouse_id") @db.Uuid

  quantity Decimal @db.Decimal(18, 6)

  /// MONEY. WAC at the moment of issue (PCR-012's basis) — frozen here so
  /// PCR-013's receipt posts "original transfer value", not a value
  /// re-derived from whatever the source item's WAC has since moved to.
  valueKobo BigInt @map("value_kobo")

  status InventoryTransferStatus @default(DRAFT)

  issueJournalEntryId  String? @map("issue_journal_entry_id") @db.Uuid
  receiptJournalEntryId String? @map("receipt_journal_entry_id") @db.Uuid

  issuedAt   DateTime? @map("issued_at")
  receivedAt DateTime? @map("received_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  item          Item          @relation(fields: [itemId], references: [id])
  fromWarehouse Warehouse     @relation("InventoryTransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse     @relation("InventoryTransferTo", fields: [toWarehouseId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  issueJournalEntry   JournalEntry? @relation("InventoryTransferIssue", fields: [issueJournalEntryId], references: [id])
  receiptJournalEntry JournalEntry? @relation("InventoryTransferReceipt", fields: [receiptJournalEntryId], references: [id])

  @@unique([companyId, transferNumber])
  @@index([companyId, status])
  @@map("inventory_transfers")
}

/// PCR-014 — an approved write-off (abnormal loss/obsolete stock), outside
/// any production order or delivery. "Count evidence and reason approval
/// required" per the rule's own blocking condition — `reason` is required,
/// same discipline as every other loss-recording path this session touched.
model InventoryWriteOff {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  branchId    String  @map("branch_id") @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  quantity    Decimal @db.Decimal(18, 6)

  /// MONEY. WAC at the moment of write-off.
  valueKobo BigInt @map("value_kobo")

  reason         String
  journalEntryId String? @map("journal_entry_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([companyId, itemId])
  @@map("inventory_write_offs")
}

// ---------------------------------------------------------------------------
// Accounting Adjustment & Manual Journal  (Consolidated Reference §3 — Phase 10)
//
// §3 asks for a dedicated "Accounting Adjustment Centre" rather than a journal
// screen buried under the GL menu. The model below is that centre.
//
// A NOTE ON WHAT IS *NOT* HERE: §3 lists JournalHeader and JournalLine. Those
// already exist — they are Phase 1's JournalEntry and JournalLine, the general
// ledger itself. What §3 actually needs is the DOCUMENT that becomes a GL
// posting once approved, which is ManualJournal below. Modelling §3's
// JournalHeader as a second ledger would give the system two places a balance
// could live, and they would eventually disagree.
//
// So: ManualJournal is a document. It goes through the Phase 2 workflow engine
// like every other document, and on final approval its registered handler calls
// the Phase 1 PostingService. There is exactly one ledger, and this writes to it
// through the same door as everything else.
// ---------------------------------------------------------------------------

enum ManualJournalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  REJECTED
  RETURNED
  CANCELLED
}

/// §3 lists General Journals, Customer/Supplier Adjustments, Opening Balances
/// and Recurring Journals as separate menu items. They are one document type
/// with different configuration, not four code paths.
enum ManualJournalKind {
  GENERAL
  CUSTOMER_ADJUSTMENT
  SUPPLIER_ADJUSTMENT
  OPENING_BALANCE
  RECURRING
  REVERSAL
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
}

/// What a recurring journal's amount represents (US-897-026). See
/// RecurringJournal.basis for what this does and doesn't govern.
enum RecurringJournalBasis {
  STRAIGHT_LINE
  USAGE_BASED
  MANUAL
}

/// §3 "Journal Types". Configuration, so a new type is data (Rule 8).
model JournalType {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  code      String
  name      String
  kind      ManualJournalKind @default(GENERAL)

  /// Whether a reason code must be supplied. An adjustment with no stated
  /// reason is the one an auditor asks about first.
  requiresReasonCode Boolean @default(true) @map("requires_reason_code")
  /// Whether supporting documentation must be attached before submission.
  requiresAttachment Boolean @default(false) @map("requires_attachment")

  /// Accruals reverse automatically in the following period. When true, posting
  /// this journal also schedules its reversal.
  autoReverse Boolean @default(false) @map("auto_reverse")

  /// Which workflow definition governs it. Defaults to the shared GL_JOURNAL
  /// route; a type may name its own for a tighter ladder.
  workflowTransactionType String @default("GL_JOURNAL") @map("workflow_transaction_type")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id])
  reasonCodes       ReasonCode[]
  journals          ManualJournal[]
  recurringJournals RecurringJournal[]

  @@unique([companyId, code])
  @@map("journal_types")
}

/// §3 "Reason Codes".
model ReasonCode {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  code          String
  name          String
  /// Null = available to every journal type.
  journalTypeId String? @map("journal_type_id") @db.Uuid

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company     Company         @relation(fields: [companyId], references: [id])
  journalType JournalType?    @relation(fields: [journalTypeId], references: [id])
  journals    ManualJournal[]

  @@unique([companyId, code])
  @@map("reason_codes")
}

/// The adjustment document. Becomes a GL posting on approval, never before.
model ManualJournal {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  journalTypeId String  @map("journal_type_id") @db.Uuid
  reasonCodeId  String? @map("reason_code_id") @db.Uuid

  reference   String
  journalDate DateTime @map("journal_date") @db.Date
  narration   String

  // --- Header dimensions (§1.1 mandatory set) ---
  branchId          String  @map("branch_id") @db.Uuid
  financialYearId   String  @map("financial_year_id") @db.Uuid
  financialPeriodId String  @map("financial_period_id") @db.Uuid
  currencyId        String  @map("currency_id") @db.Uuid
  exchangeRate      Decimal @map("exchange_rate") @db.Decimal(18, 8)

  /// §3 Customer/Supplier Adjustment. Set on the header when the whole document
  /// concerns one party, which is what makes it appear on their statement.
  customerId String? @map("customer_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  status ManualJournalStatus @default(DRAFT)

  /// Links to the Phase 2 workflow instance governing it.
  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  /// Set once posted. The bridge from document to ledger, both ways.
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  /// When this document reverses another.
  reversalOfId          String?   @map("reversal_of_id") @db.Uuid
  /// For auto-reversing accruals: the date the reversal should carry.
  scheduledReversalDate DateTime? @map("scheduled_reversal_date") @db.Date

  /// Set when generated from a recurring template.
  recurringJournalId String? @map("recurring_journal_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company          Company                   @relation(fields: [companyId], references: [id])
  journalType      JournalType               @relation(fields: [journalTypeId], references: [id])
  reasonCode       ReasonCode?               @relation(fields: [reasonCodeId], references: [id])
  branch           Branch                    @relation(fields: [branchId], references: [id])
  financialYear    FinancialYear             @relation(fields: [financialYearId], references: [id])
  financialPeriod  FinancialPeriod           @relation(fields: [financialPeriodId], references: [id])
  currency         Currency                  @relation(fields: [currencyId], references: [id])
  customer         Customer?                 @relation(fields: [customerId], references: [id])
  supplier         Supplier?                 @relation(fields: [supplierId], references: [id])
  journalEntry     JournalEntry?             @relation(fields: [journalEntryId], references: [id])
  reversalOf       ManualJournal?            @relation("ManualJournalReversal", fields: [reversalOfId], references: [id])
  reversedBy       ManualJournal[]           @relation("ManualJournalReversal")
  recurringJournal RecurringJournal?         @relation(fields: [recurringJournalId], references: [id])
  createdBy        User                      @relation("ManualJournalCreator", fields: [createdById], references: [id])
  lines            ManualJournalLine[]
  attachments      ManualJournalAttachment[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, journalDate])
  @@map("manual_journals")
}

model ManualJournalLine {
  id              String @id @default(uuid()) @db.Uuid
  manualJournalId String @map("manual_journal_id") @db.Uuid
  lineNumber      Int    @map("line_number")
  glAccountId     String @map("gl_account_id") @db.Uuid
  description     String

  /// MONEY. Integer kobo, one side only — same shape as the GL line it becomes.
  debitKobo  BigInt @default(0) @map("debit_kobo")
  creditKobo BigInt @default(0) @map("credit_kobo")

  // --- Management dimensions ---
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  penHouseId   String? @map("pen_house_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid

  // --- Business dimensions (§1.1) ---
  customerId String? @map("customer_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  itemId     String? @map("item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  manualJournal ManualJournal @relation(fields: [manualJournalId], references: [id], onDelete: Cascade)
  glAccount     GLAccount     @relation(fields: [glAccountId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  costCentre    CostCentre?   @relation(fields: [costCentreId], references: [id])
  farm          Farm?         @relation(fields: [farmId], references: [id])
  penHouse      PenHouse?     @relation(fields: [penHouseId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  item          Item?         @relation(fields: [itemId], references: [id])

  @@unique([manualJournalId, lineNumber])
  @@map("manual_journal_lines")
}

model ManualJournalAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  manualJournalId String   @map("manual_journal_id") @db.Uuid
  fileName        String   @map("file_name")
  contentType     String   @map("content_type")
  byteSize        Int      @map("byte_size")
  storageKey      String   @map("storage_key")
  uploadedById    String   @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  manualJournal ManualJournal @relation(fields: [manualJournalId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("ManualJournalAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([manualJournalId])
  @@map("manual_journal_attachments")
}

/// §3 "Recurring Journals". A template plus a schedule; each run generates a
/// normal ManualJournal that goes through the normal approval pipeline.
///
/// Generation deliberately does NOT auto-post. A recurring accrual is still an
/// accounting judgement each period, and a template that posts itself removes
/// the last human check on a figure nobody is looking at.
model RecurringJournal {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @map("company_id") @db.Uuid
  journalTypeId String @map("journal_type_id") @db.Uuid
  code          String
  name          String
  narration     String

  branchId   String  @map("branch_id") @db.Uuid
  currencyId String  @map("currency_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  frequency  RecurrenceFrequency
  /// Day of the month the journal should carry. Clamped to the month's length.
  dayOfMonth Int                 @default(1) @map("day_of_month")

  /// What the recurring amount represents (US-897-026) — display/audit only:
  /// generation still posts the flat per-line debit/credit every run,
  /// unchanged by this field. STRAIGHT_LINE for an equal-instalment
  /// prepayment/accrual, USAGE_BASED for one whose amount is expected to vary
  /// run to run even though this template can't compute that itself yet, and
  /// MANUAL for anything that doesn't fit either — the honest default so a
  /// template someone forgot to classify doesn't silently read as governed.
  basis RecurringJournalBasis @default(MANUAL)

  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  /// The next date a document is due to be generated for.
  nextRunDate DateTime  @map("next_run_date") @db.Date

  active      Boolean  @default(true)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id])
  journalType JournalType            @relation(fields: [journalTypeId], references: [id])
  branch      Branch                 @relation(fields: [branchId], references: [id])
  currency    Currency               @relation(fields: [currencyId], references: [id])
  createdBy   User                   @relation("RecurringJournalCreator", fields: [createdById], references: [id])
  lines       RecurringJournalLine[]
  generated   ManualJournal[]

  @@unique([companyId, code])
  @@index([companyId, active, nextRunDate])
  @@map("recurring_journals")
}

model RecurringJournalLine {
  id                 String @id @default(uuid()) @db.Uuid
  recurringJournalId String @map("recurring_journal_id") @db.Uuid
  lineNumber         Int    @map("line_number")
  glAccountId        String @map("gl_account_id") @db.Uuid
  description        String

  /// MONEY. Integer kobo.
  debitKobo  BigInt @default(0) @map("debit_kobo")
  creditKobo BigInt @default(0) @map("credit_kobo")

  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  projectId    String? @map("project_id") @db.Uuid
  customerId   String? @map("customer_id") @db.Uuid
  supplierId   String? @map("supplier_id") @db.Uuid
  employeeId   String? @map("employee_id") @db.Uuid
  itemId       String? @map("item_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recurringJournal RecurringJournal @relation(fields: [recurringJournalId], references: [id], onDelete: Cascade)
  glAccount        GLAccount        @relation(fields: [glAccountId], references: [id])

  @@unique([recurringJournalId, lineNumber])
  @@map("recurring_journal_lines")
}

// ---------------------------------------------------------------------------
// HR & Payroll  (Consolidated Reference §7, §7.1, §7.2 — Phase 9)
//
// This is the module with legal consequences for getting it wrong, so the rule
// the build brief states most firmly applies hardest here: NOTHING statutory is
// a constant in code. Every band, rate, threshold and applicability test below
// is an effective-dated configuration row carrying its own source reference.
//
// The Nigeria Tax Act 2025 bands take effect 1 January 2026. When they change,
// the correction is a new row with a new effective date — never an edit, so
// that a payroll run from before the change still reproduces exactly.
//
// TWO THINGS THE SOURCE DOCUMENTS SAY IN TERMS, ENCODED HERE:
//   - "Never apply the highest band rate to the whole income" — the calculation
//     is band-by-band and the per-band amounts are stored, not just the total.
//   - "Do not restore the former Consolidated Relief Allowance" — there is no
//     CRA field anywhere in this schema, and rent relief replaces it.
// ---------------------------------------------------------------------------

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  CANCELLED
}

/// §7.2: whether the employer funds the employee's pension share as well.
/// When it does, the combined statutory minimum is 18% and the employee
/// deduction becomes zero.
enum PensionFundingModel {
  SPLIT_8_10
  EMPLOYER_PAYS_ALL_18
}

/// The progressive annual bands (§7.1). Effective-dated so a mid-year change in
/// law does not rewrite January's payroll.
///
/// `bandWidth` and `lowerLimit` are both stored even though either could be
/// derived, because the workbook carries both and a band table that has to be
/// derived is a band table someone will eventually derive wrongly.
model PayeBand {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  bandOrder      Int     @map("band_order")
  /// MONEY. Integer kobo. The workbook's ₦800,000 first band is 80_000_000 kobo.
  lowerLimitKobo BigInt  @map("lower_limit_kobo")
  /// Null on the top band: it is unbounded.
  upperLimitKobo BigInt? @map("upper_limit_kobo")
  bandWidthKobo  BigInt? @map("band_width_kobo")
  /// e.g. 0.15000000 for 15%.
  rate           Decimal @db.Decimal(9, 8)

  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  sourceReference String?   @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, bandOrder, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("paye_bands")
}

/// The PAYE reliefs and thresholds that are not bands (§7.1 PAYE_Rules sheet).
model PayeConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// MONEY. Monthly gross at or below this pays no PAYE at all.
  minimumWageMonthlyKobo BigInt @map("minimum_wage_monthly_kobo")

  /// Rent relief: the lower of (annual rent x rate) and the cap. This REPLACED
  /// the Consolidated Relief Allowance; it is not an addition to it.
  rentReliefRate    Decimal @map("rent_relief_rate") @db.Decimal(9, 8)
  rentReliefCapKobo BigInt  @map("rent_relief_cap_kobo")

  /// The pension rate used when computing the PAYE DEDUCTION. Kept separate
  /// from the statutory contribution rate: they happen to be equal today, and
  /// conflating them would hide it if the law ever separated them.
  pensionReliefRate Decimal @map("pension_relief_rate") @db.Decimal(9, 8)

  /// Rounding for the final payroll line. §7.1: "Round only at the final
  /// payroll line; preserve calculation precision."
  rounding RoundingRule @default(HALF_UP)

  /// Version stamp recorded on every calculation, so a snapshot can be tied to
  /// the exact rule set that produced it (the workbook's "NTA-2025-2026.01").
  ruleVersion String @map("rule_version")

  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  sourceReference String?   @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, effectiveFrom])
  @@map("paye_configurations")
}

/// §7.2 NHF / ITF / NSITF / Pension. Every rate and applicability test.
model StatutoryConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  // --- Pension ---
  pensionFunding      PensionFundingModel @default(SPLIT_8_10) @map("pension_funding")
  pensionEmployeeRate Decimal             @map("pension_employee_rate") @db.Decimal(9, 8)
  pensionEmployerRate Decimal             @map("pension_employer_rate") @db.Decimal(9, 8)
  /// Used when the employer funds the whole contribution.
  pensionCombinedRate Decimal             @map("pension_combined_rate") @db.Decimal(9, 8)
  /// The Pension Reform Act applies from this headcount upward.
  pensionMinEmployees Int                 @default(3) @map("pension_min_employees")

  // --- NHF ---
  nhfRate                 Decimal @map("nhf_rate") @db.Decimal(9, 8)
  /// Private-sector participation is voluntary; without this the scheme is off
  /// for the whole company however many employees have ticked the box.
  nhfCompanyParticipation Boolean @default(false) @map("nhf_company_participation")

  // --- NSITF (employer only; deducting it from an employee is prohibited) ---
  nsitfRate Decimal @map("nsitf_rate") @db.Decimal(9, 8)

  // --- ITF (employer only; annual payment, monthly accrual) ---
  itfRate         Decimal @map("itf_rate") @db.Decimal(9, 8)
  itfMinEmployees Int     @default(25) @map("itf_min_employees")

  /// MONEY. NHF eligibility floor, and the same figure PAYE exempts below.
  minimumWageMonthlyKobo BigInt @map("minimum_wage_monthly_kobo")

  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  sourceReference String?   @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, effectiveFrom])
  @@map("statutory_configurations")
}

/// Per-employee annual relief inputs (§7.1 Employee_Inputs sheet).
///
/// Effective-dated by tax year because these are declared annually with
/// supporting evidence, and last year's declaration must not silently apply to
/// this year's payroll.
model EmployeeTaxRelief {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  taxYear    Int    @map("tax_year")

  /// MONEY, all integer kobo, all ANNUAL figures.
  annualRentKobo             BigInt @default(0) @map("annual_rent_kobo")
  nhfAnnualKobo              BigInt @default(0) @map("nhf_annual_kobo")
  nhisAnnualKobo             BigInt @default(0) @map("nhis_annual_kobo")
  lifeAssuranceAnnualKobo    BigInt @default(0) @map("life_assurance_annual_kobo")
  mortgageInterestAnnualKobo BigInt @default(0) @map("mortgage_interest_annual_kobo")
  /// Irregular income annualised separately from recurring pay.
  annualBonusKobo            BigInt @default(0) @map("annual_bonus_kobo")

  /// §7.1: "all reliefs must be based on actual supported amounts" — a relief
  /// without evidence is not granted.
  documentsComplete Boolean @default(false) @map("documents_complete")
  evidenceReference String? @map("evidence_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, taxYear])
  @@map("employee_tax_reliefs")
}

/// One month's payroll for one company.
model PayrollRun {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  year        Int
  month       Int
  reference   String
  /// The date the accrual carries, and the date every rate is resolved as at.
  payrollDate DateTime @map("payroll_date") @db.Date

  branchId          String @map("branch_id") @db.Uuid
  financialYearId   String @map("financial_year_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid
  currencyId        String @map("currency_id") @db.Uuid

  status PayrollRunStatus @default(DRAFT)

  /// Headcount as at calculation, which drives the pension and ITF
  /// applicability tests. Stored because it is an input to the result and must
  /// not be re-derived later from a changed employee list.
  employeeCount Int @default(0) @map("employee_count")

  /// MONEY. Control totals, all integer kobo.
  totalGrossKobo           BigInt @default(0) @map("total_gross_kobo")
  totalPayeKobo            BigInt @default(0) @map("total_paye_kobo")
  totalEmployeePensionKobo BigInt @default(0) @map("total_employee_pension_kobo")
  totalEmployerPensionKobo BigInt @default(0) @map("total_employer_pension_kobo")
  totalNhfKobo             BigInt @default(0) @map("total_nhf_kobo")
  totalNsitfKobo           BigInt @default(0) @map("total_nsitf_kobo")
  totalItfKobo             BigInt @default(0) @map("total_itf_kobo")
  totalOtherDeductionsKobo BigInt @default(0) @map("total_other_deductions_kobo")
  totalNetPayKobo          BigInt @default(0) @map("total_net_pay_kobo")

  /// The rule versions this run was computed under, for §7.1's audit
  /// requirement. A recalculation creates a new run rather than mutating this.
  payeRuleVersion String? @map("paye_rule_version")

  /// How much of each payable bucket a PayrollPayment has cleared
  /// (US-897-024) — the same running-settlement idea SupplierInvoice's
  /// settledAmountKobo already uses, split one field per bucket because the
  /// accrual itself credits six separate payable accounts, typically remitted
  /// on different days to different payees (staff, FIRS, a PFA, NHF, NSITF,
  /// ITF). Pension is one field, matching the accrual: the employee and
  /// employer shares post to ONE Pension Payable credit, not two.
  totalSalarySettledKobo  BigInt @default(0) @map("total_salary_settled_kobo")
  totalPayeSettledKobo    BigInt @default(0) @map("total_paye_settled_kobo")
  totalPensionSettledKobo BigInt @default(0) @map("total_pension_settled_kobo")
  totalNhfSettledKobo     BigInt @default(0) @map("total_nhf_settled_kobo")
  totalNsitfSettledKobo   BigInt @default(0) @map("total_nsitf_settled_kobo")
  totalItfSettledKobo     BigInt @default(0) @map("total_itf_settled_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  calculatedAt DateTime? @map("calculated_at")
  postedAt     DateTime? @map("posted_at")
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  financialYear   FinancialYear    @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod  @relation(fields: [financialPeriodId], references: [id])
  currency        Currency         @relation(fields: [currencyId], references: [id])
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdBy       User             @relation("PayrollRunCreator", fields: [createdById], references: [id])
  lines           PayrollRunLine[]
  payments        PayrollPayment[]

  @@unique([companyId, year, month])
  @@unique([companyId, reference])
  @@index([companyId, status])
  @@map("payroll_runs")
}

/// Which of the six liability accounts a PayrollRun's accrual credits
/// (US-897-024) — see PayrollRunService.postApproved's own payables list.
enum PayrollPayableBucket {
  SALARY
  PAYE
  PENSION
  NHF
  NSITF
  ITF
}

/// Clears one payable bucket of one payroll run — Dr [bucket] Payable /
/// Cr Bank, the same maker-checker document shape SupplierPayment already
/// uses, allocated against outstanding rather than posting straight to the
/// ledger. Nothing before this cleared these balances: PayrollRunService
/// posts the accrual correctly, and it has sat as a liability ever since.
model PayrollPayment {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  payrollRunId String @map("payroll_run_id") @db.Uuid

  paymentNumber String                @map("payment_number")
  bucket        PayrollPayableBucket
  /// MONEY. What this payment settles of the bucket's outstanding balance.
  amountKobo    BigInt                @map("amount_kobo")

  paymentDate     DateTime      @map("payment_date") @db.Date
  method          PaymentMethod
  bankGlAccountId String        @map("bank_gl_account_id") @db.Uuid
  reference       String?
  narration       String?

  branchId          String @map("branch_id") @db.Uuid
  currencyId        String @map("currency_id") @db.Uuid
  financialYearId   String @map("financial_year_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid

  status                PaymentStatus @default(DRAFT)
  workflowTransactionId String?       @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String?       @map("journal_entry_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  payrollRun          PayrollRun           @relation(fields: [payrollRunId], references: [id])
  bankGlAccount       GLAccount            @relation(fields: [bankGlAccountId], references: [id])
  branch              Branch               @relation(fields: [branchId], references: [id])
  currency            Currency             @relation(fields: [currencyId], references: [id])
  financialYear       FinancialYear        @relation(fields: [financialYearId], references: [id])
  financialPeriod     FinancialPeriod      @relation(fields: [financialPeriodId], references: [id])
  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  createdBy           User                 @relation("PayrollPaymentCreator", fields: [createdById], references: [id])

  @@unique([companyId, paymentNumber])
  @@map("payroll_payments")
}

/// One employee's pay for one run.
///
/// Every intermediate figure is stored, not just the answer. §7.1 requires the
/// calculation snapshot to be reproducible, and "trust us, 32,911.70 is right"
/// is not a snapshot — an auditor needs to see the chargeable income and the
/// band-by-band split that produced it.
model PayrollRunLine {
  id           String @id @default(uuid()) @db.Uuid
  payrollRunId String @map("payroll_run_id") @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid

  /// Denormalised at calculation time. An employee who later moves cost centre
  /// must not retroactively move last month's payroll expense.
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid
  taxState     String? @map("tax_state")

  // --- Pay, all MONEY in integer kobo ---
  monthlyGrossKobo          BigInt @map("monthly_gross_kobo")
  taxableGrossKobo          BigInt @map("taxable_gross_kobo")
  pensionableEmolumentsKobo BigInt @map("pensionable_emoluments_kobo")

  // --- PAYE working (§7.1) ---
  annualGrossKobo            BigInt  @map("annual_gross_kobo")
  annualPensionReliefKobo    BigInt  @map("annual_pension_relief_kobo")
  annualNhfReliefKobo        BigInt  @map("annual_nhf_relief_kobo")
  annualNhisReliefKobo       BigInt  @map("annual_nhis_relief_kobo")
  annualLifeAssuranceKobo    BigInt  @map("annual_life_assurance_kobo")
  annualMortgageInterestKobo BigInt  @map("annual_mortgage_interest_kobo")
  rentReliefKobo             BigInt  @map("rent_relief_kobo")
  totalReliefsKobo           BigInt  @map("total_reliefs_kobo")
  chargeableIncomeKobo       BigInt  @map("chargeable_income_kobo")
  annualPayeKobo             BigInt  @map("annual_paye_kobo")
  monthlyPayeKobo            BigInt  @map("monthly_paye_kobo")
  minimumWageExempt          Boolean @default(false) @map("minimum_wage_exempt")

  // --- Statutory (§7.2) ---
  employeePensionKobo BigInt @map("employee_pension_kobo")
  employerPensionKobo BigInt @map("employer_pension_kobo")
  nhfKobo             BigInt @map("nhf_kobo")
  nsitfKobo           BigInt @map("nsitf_kobo")
  itfKobo             BigInt @map("itf_kobo")

  otherDeductionsKobo BigInt @default(0) @map("other_deductions_kobo")
  netPayKobo          BigInt @map("net_pay_kobo")

  /// The full band-by-band trace and the inputs that produced it.
  calculationSnapshot Json @map("calculation_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  payrollRun PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  costCentre CostCentre? @relation("PayrollLineCostCentre", fields: [costCentreId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId, taxState])
  @@map("payroll_run_lines")
}

// ---------------------------------------------------------------------------
// Order-to-Cash  (Consolidated Reference §6 — Phase 8)
//
// Quotation -> Sales Order -> Credit Check -> Delivery -> Invoice -> Receipt.
// Every document is workflow-governed and posts through the Phase 1 service.
//
// A CONTRADICTION IN §6, RESOLVED SAFELY RATHER THAN SILENTLY:
//
//   §6 gives the Delivery Note posting as "Inventory -> Cost of Sales" AND the
//   Sales Invoice posting as "Dr Trade Receivable / Cr Revenue / Cr Output VAT"
//   PLUS "Dr Cost of Sales / Cr Inventory". Read literally, cost of sales is
//   recognised twice for one sale.
//
//   Both readings are defensible — COGS at delivery is when control transfers,
//   COGS at invoice is simpler when the two coincide — so this is configuration
//   (SalesConfiguration.cogsRecognitionPoint), NOT a decision buried in code.
//   Whichever is chosen, `DeliveryNoteLine.cogsPostedAt` records where COGS was
//   actually recognised, and neither path will post it for a line that already
//   carries one. Double-counting is prevented structurally, not by care.
//
// INVENTORY VALUATION: cost of sales uses the Phase 4 effective-dated standard
// cost. A perpetual FIFO or weighted-average valuation needs an inward stock
// flow, which arrives with Procure-to-Pay (Phase 7) and Processing (Phase 6).
// StockMovement below is the shared ledger those phases will write into; for
// now only the outward side exists, and availability is therefore not enforced.
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_DELIVERED
  FULLY_DELIVERED
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISPATCHED
  DELIVERED
  POSTED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  PART_PAID
  PAID
  CANCELLED
}

enum ReceiptMethod {
  BANK_TRANSFER
  CASH
  POS
  CHEQUE
  // Mobile Money is marked "Future" in §6 and is deliberately absent.
}

enum ReceiptStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

/// §6 Credit Note reasons, verbatim.
enum CreditNoteReason {
  PRICING_ERROR
  RETURNED_GOODS
  PROMOTIONAL_DISCOUNT
  INVOICE_CANCELLATION
  AUDIT_ADJUSTMENT
}

enum CreditNoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  CANCELLED
}

enum ReturnCondition {
  RESALEABLE
  DAMAGED
  EXPIRED
  QUARANTINE
}

enum StockDirection {
  IN
  OUT
}

/// Where cost of sales is recognised. See the note at the head of this section.
enum CogsRecognitionPoint {
  DELIVERY
  INVOICE
}

/// Company-level sales policy. Everything here would otherwise be a constant.
model SalesConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  cogsRecognitionPoint CogsRecognitionPoint @default(DELIVERY) @map("cogs_recognition_point")

  /// Whether a delivery may proceed when recorded stock is insufficient.
  /// Defaults to permitting it because the inward stock flow does not exist
  /// until Phase 6/7 — turning this on before then would block every delivery.
  allowNegativeStock Boolean @default(true) @map("allow_negative_stock")

  /// Transaction type used when a sales order passes credit control, and the
  /// tighter route used when it does not (§6: "Failure -> routes to Credit
  /// Approval Workflow").
  salesOrderTransactionType     String @default("SALES_ORDER") @map("sales_order_transaction_type")
  creditOverrideTransactionType String @default("SALES_ORDER_CREDIT_OVERRIDE") @map("credit_override_transaction_type")

  /// Default GL accounts for the O2C postings.
  receivableGlAccountId    String  @map("receivable_gl_account_id") @db.Uuid
  revenueGlAccountId       String  @map("revenue_gl_account_id") @db.Uuid
  costOfSalesGlAccountId   String  @map("cost_of_sales_gl_account_id") @db.Uuid
  inventoryGlAccountId     String  @map("inventory_gl_account_id") @db.Uuid
  whtReceivableGlAccountId String? @map("wht_receivable_gl_account_id") @db.Uuid

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company              Company    @relation(fields: [companyId], references: [id])
  receivableAccount    GLAccount  @relation("SalesReceivableAccount", fields: [receivableGlAccountId], references: [id])
  revenueAccount       GLAccount  @relation("SalesRevenueAccount", fields: [revenueGlAccountId], references: [id])
  costOfSalesAccount   GLAccount  @relation("SalesCostOfSalesAccount", fields: [costOfSalesGlAccountId], references: [id])
  inventoryAccount     GLAccount  @relation("SalesInventoryAccount", fields: [inventoryGlAccountId], references: [id])
  whtReceivableAccount GLAccount? @relation("SalesWhtReceivableAccount", fields: [whtReceivableGlAccountId], references: [id])

  @@index([companyId, effectiveFrom])
  @@map("sales_configurations")
}

/// The shared inventory ledger.
///
/// Written by every module that moves stock. O2C writes the outward side today;
/// Procure-to-Pay and Processing write the inward side when they land. Keeping
/// one ledger rather than a table per module is what will let stock on hand be
/// a query rather than a reconciliation.
model StockMovement {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  itemId      String         @map("item_id") @db.Uuid
  warehouseId String         @map("warehouse_id") @db.Uuid
  direction   StockDirection

  /// QUANTITY, always positive; `direction` carries the sign.
  quantity Decimal @db.Decimal(18, 6)

  /// MONEY. Integer kobo.
  unitCostKobo BigInt @map("unit_cost_kobo")
  valueKobo    BigInt @map("value_kobo")

  /// Batch/lot for traceability (§10 requires it; O2C carries it through).
  batchReference String? @map("batch_reference")

  sourceModule       String   @map("source_module")
  sourceDocumentType String   @map("source_document_type")
  sourceDocumentId   String   @map("source_document_id")
  documentReference  String   @map("document_reference")
  movementDate       DateTime @map("movement_date") @db.Date

  journalEntryId String? @map("journal_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  productionOrderComponents ProductionOrderComponent[]
  productionOrderOutputs    ProductionOrderOutput[]

  @@index([companyId, itemId, warehouseId])
  @@index([sourceDocumentType, sourceDocumentId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Sales Quotation (§6)
// ---------------------------------------------------------------------------

model SalesQuotation {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  quoteNumber String @map("quote_number")
  customerId  String @map("customer_id") @db.Uuid

  quoteDate  DateTime @map("quote_date") @db.Date
  validUntil DateTime @map("valid_until") @db.Date

  currencyId   String  @map("currency_id") @db.Uuid
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(18, 8)

  branchId      String  @map("branch_id") @db.Uuid
  farmId        String? @map("farm_id") @db.Uuid
  costCentreId  String? @map("cost_centre_id") @db.Uuid
  salespersonId String? @map("salesperson_id") @db.Uuid

  remarks String?
  status  QuotationStatus @default(DRAFT)

  /// MONEY, integer kobo. Control totals.
  netAmountKobo   BigInt @default(0) @map("net_amount_kobo")
  vatAmountKobo   BigInt @default(0) @map("vat_amount_kobo")
  grossAmountKobo BigInt @default(0) @map("gross_amount_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id])
  customer    Customer             @relation(fields: [customerId], references: [id])
  currency    Currency             @relation(fields: [currencyId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])
  farm        Farm?                @relation(fields: [farmId], references: [id])
  costCentre  CostCentre?          @relation("QuotationCostCentre", fields: [costCentreId], references: [id])
  salesperson User?                @relation("QuotationSalesperson", fields: [salespersonId], references: [id])
  createdBy   User                 @relation("QuotationCreator", fields: [createdById], references: [id])
  lines       SalesQuotationLine[]
  salesOrders SalesOrder[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@map("sales_quotations")
}

model SalesQuotationLine {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  lineNumber  Int    @map("line_number")
  itemId      String @map("item_id") @db.Uuid
  description String

  quantity      Decimal @db.Decimal(18, 6)
  /// MONEY per unit, integer kobo.
  unitPriceKobo BigInt  @map("unit_price_kobo")
  discountKobo  BigInt  @default(0) @map("discount_kobo")

  taxCodeId     String? @map("tax_code_id") @db.Uuid
  netAmountKobo BigInt  @map("net_amount_kobo")
