model Warehouse {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  branchId  String        @map("branch_id") @db.Uuid
  code      String
  name      String
  type      WarehouseType @default(GENERAL)
  active    Boolean       @default(true)
