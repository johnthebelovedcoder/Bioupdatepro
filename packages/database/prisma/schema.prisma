// ---------------------------------------------------------------------------
// Procure-to-Pay  (Consolidated Reference §5 — Phase 7)
//
// PR -> RFQ -> PO -> GRN -> Supplier Invoice -> Three-Way Match -> Payment.
//
// THE GRNI MECHANISM, AND WHY IT MATTERS HERE:
//
//   §5 gives the GRN posting as "Dr Inventory / Cr GRNI (Goods Received Not
//   Invoiced)" and the Supplier Invoice posting as "Dr Inventory/Expense /
//   Dr Input VAT Recoverable / Cr Trade Payables". Read literally, an item that
//   is both received and invoiced debits inventory TWICE.
//
//   GRNI — which §5 names itself — is the resolution. Goods arriving debit
//   inventory and credit GRNI, a holding account for "we have the goods but not
//   the bill". The invoice then DEBITS GRNI to clear it, rather than debiting
//   inventory again. Inventory is recognised once, at receipt, which is when
//   control actually passes.
//
//   That makes GRNI this phase's accounting identity: for a purchase order
//   fully received and fully invoiced, the GRNI balance must be exactly zero.
//   It is the direct analogue of the WIP-clearing test, and the integration
//   suite proves it rather than eyeballing it.
//
// The inward side of StockMovement lands here, so from this phase on stock on
// hand is a real figure and availability can be enforced.
// ---------------------------------------------------------------------------

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
  CLOSED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  ISSUED
  EVALUATED
  CLOSED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

enum GrnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

/// §5 GRN carries a "Quality Inspection Status".
enum QualityStatus {
  PENDING
  PASSED
  FAILED
  PARTIAL
}

enum SupplierInvoiceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  POSTED
  PART_PAID
  PAID
  CANCELLED
}

/// §5 Three-Way Matching compares PO / GRN / Invoice and routes exceptions to
/// approval. The outcome is stored, not recomputed: what mattered is what the
/// approver saw at the time.
enum MatchStatus {
  NOT_MATCHED
  MATCHED
  EXCEPTION
  /// A standalone invoice with no PO or GRN to match against.
  NOT_APPLICABLE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  // Mobile Money is marked "Future" in §5 and is deliberately absent.
}

enum PaymentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

/// Company-level procurement policy.
model ProcurementConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The GRNI holding account. Without this the whole receive-then-invoice
  /// sequence has nowhere to park the liability, so it is NOT optional.
  grniGlAccountId       String  @map("grni_gl_account_id") @db.Uuid
  payablesGlAccountId   String  @map("payables_gl_account_id") @db.Uuid
  whtPayableGlAccountId String? @map("wht_payable_gl_account_id") @db.Uuid

  /// §5 Three-Way Matching tolerances. Zero means exact match required.
  quantityTolerancePercent Decimal @default(0) @map("quantity_tolerance_percent") @db.Decimal(9, 6)
  priceTolerancePercent    Decimal @default(0) @map("price_tolerance_percent") @db.Decimal(9, 6)

  /// Whether a receipt may exceed the ordered quantity, and by how much.
  overReceiptTolerancePercent Decimal @default(0) @map("over_receipt_tolerance_percent") @db.Decimal(9, 6)

  /// Once the inward stock flow exists — which is this phase — availability can
  /// be enforced. Defaults to enforcing it.
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")

  /// Transaction type for an invoice that matched cleanly, and the tighter
  /// route for one that did not (§5: "Exceptions require approval").
  invoiceTransactionType        String @default("SUPPLIER_INVOICE") @map("invoice_transaction_type")
  matchExceptionTransactionType String @default("SUPPLIER_INVOICE_EXCEPTION") @map("match_exception_transaction_type")

  /// Same idea, for a goods receipt: the clean route vs. the tighter one for
  /// a receipt over the over-receipt tolerance (US-897-007).
  grnTransactionType          String @default("GOODS_RECEIPT") @map("grn_transaction_type")
  grnExceptionTransactionType String @default("GOODS_RECEIPT_EXCEPTION") @map("grn_exception_transaction_type")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company           Company    @relation(fields: [companyId], references: [id])
  grniAccount       GLAccount  @relation("ProcurementGrniAccount", fields: [grniGlAccountId], references: [id])
  payablesAccount   GLAccount  @relation("ProcurementPayablesAccount", fields: [payablesGlAccountId], references: [id])
  whtPayableAccount GLAccount? @relation("ProcurementWhtPayableAccount", fields: [whtPayableGlAccountId], references: [id])

  @@index([companyId, effectiveFrom])
  @@map("procurement_configurations")
}

// ---------------------------------------------------------------------------
// §5 Purchase Requisition
// ---------------------------------------------------------------------------

model PurchaseRequisition {
  id                String @id @default(uuid()) @db.Uuid
  companyId         String @map("company_id") @db.Uuid
  requisitionNumber String @map("requisition_number")

  requestDate  DateTime  @map("request_date") @db.Date
  requiredDate DateTime? @map("required_date") @db.Date

  requesterId  String  @map("requester_id") @db.Uuid
  branchId     String  @map("branch_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid

  justification String?
  status        RequisitionStatus @default(DRAFT)

  /// MONEY. Estimated only — a requisition commits nothing.
  estimatedCostKobo BigInt @default(0) @map("estimated_cost_kobo")

  currencyId String @map("currency_id") @db.Uuid

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company                   @relation(fields: [companyId], references: [id])
  requester      User                      @relation("RequisitionRequester", fields: [requesterId], references: [id])
  branch         Branch                    @relation(fields: [branchId], references: [id])
  department     Department?               @relation(fields: [departmentId], references: [id])
  costCentre     CostCentre?               @relation("RequisitionCostCentre", fields: [costCentreId], references: [id])
  farm           Farm?                     @relation(fields: [farmId], references: [id])
  currency       Currency                  @relation(fields: [currencyId], references: [id])
  lines          PurchaseRequisitionLine[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, requisitionNumber])
  @@index([companyId, status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id            String @id @default(uuid()) @db.Uuid
  requisitionId String @map("requisition_id") @db.Uuid
  lineNumber    Int    @map("line_number")
  itemId        String @map("item_id") @db.Uuid
  description   String

  quantity              Decimal @db.Decimal(18, 6)
  /// MONEY. An estimate, typically the item's standard cost.
  estimatedUnitCostKobo BigInt  @map("estimated_unit_cost_kobo")

  /// How much of this line has been placed on a purchase order.
  orderedQuantity Decimal @default(0) @map("ordered_quantity") @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item                @relation(fields: [itemId], references: [id])

  @@unique([requisitionId, lineNumber])
  @@map("purchase_requisition_lines")
}

// ---------------------------------------------------------------------------
// §5 RFQ and quotation comparison (optional in the flow)
// ---------------------------------------------------------------------------

model Rfq {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  rfqNumber     String  @map("rfq_number")
  requisitionId String? @map("requisition_id") @db.Uuid

  issueDate     DateTime  @map("issue_date") @db.Date
  validityDate  DateTime? @map("validity_date") @db.Date
  deliveryTerms String?   @map("delivery_terms")

  status RfqStatus @default(DRAFT)

  /// The quotation chosen after comparison, and why.
  awardedQuotationId String? @unique @map("awarded_quotation_id") @db.Uuid
  awardReason        String? @map("award_reason")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company        Company              @relation(fields: [companyId], references: [id])
  requisition    PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  createdBy      User                 @relation("RfqCreator", fields: [createdById], references: [id])
  quotations     SupplierQuotation[]  @relation("RfqQuotations")
  awarded        SupplierQuotation?   @relation("RfqAward", fields: [awardedQuotationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, rfqNumber])
  @@map("rfqs")
}

model SupplierQuotation {
  id         String @id @default(uuid()) @db.Uuid
  rfqId      String @map("rfq_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  quotationReference String    @map("quotation_reference")
  quotationDate      DateTime  @map("quotation_date") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date

  /// MONEY. Control total for comparison.
  totalAmountKobo BigInt @default(0) @map("total_amount_kobo")
  /// Lead time in days, the other axis a buyer compares on.
  leadTimeDays    Int?   @map("lead_time_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rfq       Rfq                     @relation("RfqQuotations", fields: [rfqId], references: [id], onDelete: Cascade)
  supplier  Supplier                @relation(fields: [supplierId], references: [id])
  awardedIn Rfq?                    @relation("RfqAward")
  lines     SupplierQuotationLine[]

  @@unique([rfqId, supplierId])
  @@map("supplier_quotations")
}

model SupplierQuotationLine {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  lineNumber  Int    @map("line_number")
  itemId      String @map("item_id") @db.Uuid

  quantity      Decimal @db.Decimal(18, 6)
  unitPriceKobo BigInt  @map("unit_price_kobo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      Item              @relation(fields: [itemId], references: [id])

  @@unique([quotationId, lineNumber])
  @@map("supplier_quotation_lines")
}

// ---------------------------------------------------------------------------
// §5 Purchase Order
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  orderNumber String @map("order_number")
  supplierId  String @map("supplier_id") @db.Uuid

  requisitionId String? @map("requisition_id") @db.Uuid
  rfqId         String? @map("rfq_id") @db.Uuid

  orderDate            DateTime  @map("order_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  currencyId   String  @map("currency_id") @db.Uuid
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(18, 8)

  paymentTermId   String? @map("payment_term_id") @db.Uuid
  deliveryAddress String? @map("delivery_address")

  branchId     String  @map("branch_id") @db.Uuid
  warehouseId  String  @map("warehouse_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid

  status PurchaseOrderStatus @default(DRAFT)

  netAmountKobo   BigInt @default(0) @map("net_amount_kobo")
  vatAmountKobo   BigInt @default(0) @map("vat_amount_kobo")
  grossAmountKobo BigInt @default(0) @map("gross_amount_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  /// Increments on every amendment while still DRAFT (US-897-006). Not a
  /// separate version table — unlike a recipe, nothing outside this row ever
  /// needs to resolve "which version was this at as of date X", since
  /// amendment is only possible before anything downstream (a receipt, an
  /// invoice) could exist to have been computed against an earlier one.
  version Int @default(1)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id])
  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  rfq         Rfq?                 @relation(fields: [rfqId], references: [id])
  currency    Currency             @relation(fields: [currencyId], references: [id])
  paymentTerm PaymentTerm?         @relation(fields: [paymentTermId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  farm        Farm?                @relation(fields: [farmId], references: [id])
  department  Department?          @relation(fields: [departmentId], references: [id])
  costCentre  CostCentre?          @relation("PurchaseOrderCostCentre", fields: [costCentreId], references: [id])
  createdBy   User                 @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  lines       PurchaseOrderLine[]
  receipts    GoodsReceiptNote[]
  invoices    SupplierInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  lineNumber      Int    @map("line_number")
  itemId          String @map("item_id") @db.Uuid
  description     String

  requisitionLineId String? @map("requisition_line_id") @db.Uuid

  quantity         Decimal @db.Decimal(18, 6)
  /// Progress, both tracked so the three-way match has something to compare.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 6)
  invoicedQuantity Decimal @default(0) @map("invoiced_quantity") @db.Decimal(18, 6)

  unitPriceKobo BigInt @map("unit_price_kobo")

  taxCodeId     String? @map("tax_code_id") @db.Uuid
  netAmountKobo BigInt  @map("net_amount_kobo")
  vatAmountKobo BigInt  @default(0) @map("vat_amount_kobo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item                   @relation(fields: [itemId], references: [id])
  taxCode       TaxCode?               @relation("PurchaseOrderLineTaxCode", fields: [taxCodeId], references: [id])
  receiptLines  GoodsReceiptNoteLine[]
  invoiceLines  SupplierInvoiceLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// §5 Goods Receipt Note
// ---------------------------------------------------------------------------

model GoodsReceiptNote {
  id              String @id @default(uuid()) @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  grnNumber       String @map("grn_number")
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  supplierId      String @map("supplier_id") @db.Uuid

  receiptDate DateTime @map("receipt_date") @db.Date
  warehouseId String   @map("warehouse_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid

  deliveryNoteReference String?       @map("delivery_note_reference")
  qualityStatus         QualityStatus @default(PENDING) @map("quality_status")
  inspectedById         String?       @map("inspected_by_id") @db.Uuid

  status GrnStatus @default(DRAFT)

  /// One or more lines received beyond the configured over-receipt
  /// tolerance. Does not block creation — §5's own sibling control, three-way
  /// match, treats an out-of-tolerance invoice as something requiring
  /// approval, not something refused, and a GRN takes the same route: `submit`
  /// reads this to route through the tighter exception transaction type.
  overTolerance Boolean @default(false) @map("over_tolerance")
  /// Which line(s) and by how much, for the approver — mirrors
  /// SupplierInvoiceService's three-way match findings.
  toleranceNote String? @map("tolerance_note")

  /// MONEY. Value of goods accepted into stock, at PO price.
  totalValueKobo BigInt @default(0) @map("total_value_kobo")

  financialYearId   String @map("financial_year_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid
  currencyId        String @map("currency_id") @db.Uuid

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company         Company                @relation(fields: [companyId], references: [id])
  purchaseOrder   PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id])
  branch          Branch                 @relation(fields: [branchId], references: [id])
  financialYear   FinancialYear          @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod        @relation(fields: [financialPeriodId], references: [id])
  currency        Currency               @relation(fields: [currencyId], references: [id])
  inspectedBy     User?                  @relation("GrnInspector", fields: [inspectedById], references: [id])
  journalEntry    JournalEntry?          @relation(fields: [journalEntryId], references: [id])
  createdBy       User                   @relation("GrnCreator", fields: [createdById], references: [id])
  lines           GoodsReceiptNoteLine[]

  @@unique([companyId, grnNumber])
  @@index([companyId, status])
  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteLine {
  id                  String @id @default(uuid()) @db.Uuid
  goodsReceiptNoteId  String @map("goods_receipt_note_id") @db.Uuid
  lineNumber          Int    @map("line_number")
  purchaseOrderLineId String @map("purchase_order_line_id") @db.Uuid
  itemId              String @map("item_id") @db.Uuid

  /// QUANTITIES. §5 asks for ordered / received / rejected separately, because
  /// the difference between them is what an exception report is made of.
  orderedQuantity  Decimal @map("ordered_quantity") @db.Decimal(18, 6)
  receivedQuantity Decimal @map("received_quantity") @db.Decimal(18, 6)
  rejectedQuantity Decimal @default(0) @map("rejected_quantity") @db.Decimal(18, 6)
  /// received less rejected — what actually enters stock and GRNI.
  acceptedQuantity Decimal @map("accepted_quantity") @db.Decimal(18, 6)

  unitPriceKobo BigInt @map("unit_price_kobo")
  valueKobo     BigInt @map("value_kobo")

  batchReference String?   @map("batch_reference")
  expiryDate     DateTime? @map("expiry_date") @db.Date

  /// US-897-007's per-line location. Null means "the GRN's own header
  /// warehouse" — every receipt before this went into one warehouse for the
  /// whole document; this lets one line land somewhere else without forcing
  /// every receipt to name a location it doesn't need.
  warehouseId String? @map("warehouse_id") @db.Uuid

  /// How much of the accepted quantity has been invoiced. The GRNI balance for
  /// this line is (accepted - invoiced) x price, and it must reach zero.
  invoicedQuantity Decimal @default(0) @map("invoiced_quantity") @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  goodsReceiptNote  GoodsReceiptNote      @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine     @relation(fields: [purchaseOrderLineId], references: [id])
  item              Item                  @relation(fields: [itemId], references: [id])
  warehouse         Warehouse?            @relation(fields: [warehouseId], references: [id])
  invoiceLines      SupplierInvoiceLine[]

  @@unique([goodsReceiptNoteId, lineNumber])
  @@map("goods_receipt_note_lines")
}

// ---------------------------------------------------------------------------
// §5 Supplier Invoice and Three-Way Match
// ---------------------------------------------------------------------------

model SupplierInvoice {
  id                    String @id @default(uuid()) @db.Uuid
  companyId             String @map("company_id") @db.Uuid
  /// Our internal reference.
  invoiceNumber         String @map("invoice_number")
  /// The supplier's own invoice number — the one that must not be paid twice.
  supplierInvoiceNumber String @map("supplier_invoice_number")
  supplierId            String @map("supplier_id") @db.Uuid

  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  invoiceDate DateTime  @map("invoice_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date

  currencyId   String  @map("currency_id") @db.Uuid
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(18, 8)

  branchId     String  @map("branch_id") @db.Uuid
  farmId       String? @map("farm_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid

  financialYearId   String @map("financial_year_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid

  /// §5: the WHT category to apply when this invoice is paid.
  whtTaxCodeId String? @map("wht_tax_code_id") @db.Uuid

  status      SupplierInvoiceStatus @default(DRAFT)
  matchStatus MatchStatus           @default(NOT_MATCHED) @map("match_status")
  /// The three-way match findings as at approval. Stored, not recomputed:
  /// what matters is what the approver actually saw.
  matchResult Json?                 @map("match_result")

  netAmountKobo     BigInt @default(0) @map("net_amount_kobo")
  vatAmountKobo     BigInt @default(0) @map("vat_amount_kobo")
  grossAmountKobo   BigInt @default(0) @map("gross_amount_kobo")
  settledAmountKobo BigInt @default(0) @map("settled_amount_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company         Company               @relation(fields: [companyId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  currency        Currency              @relation(fields: [currencyId], references: [id])
  branch          Branch                @relation(fields: [branchId], references: [id])
  farm            Farm?                 @relation(fields: [farmId], references: [id])
  department      Department?           @relation(fields: [departmentId], references: [id])
  costCentre      CostCentre?           @relation("SupplierInvoiceCostCentre", fields: [costCentreId], references: [id])
  financialYear   FinancialYear         @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod       @relation(fields: [financialPeriodId], references: [id])
  whtTaxCode      TaxCode?              @relation("SupplierInvoiceWhtCode", fields: [whtTaxCodeId], references: [id])
  journalEntry    JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  createdBy       User                  @relation("SupplierInvoiceCreator", fields: [createdById], references: [id])
  lines           SupplierInvoiceLine[]
  allocations     PaymentAllocation[]

  /// The supplier's own number, unique per supplier: the single most effective
  /// guard against paying the same invoice twice.
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  lineNumber  Int    @map("line_number")
  itemId      String @map("item_id") @db.Uuid
  description String

  purchaseOrderLineId    String? @map("purchase_order_line_id") @db.Uuid
  goodsReceiptNoteLineId String? @map("goods_receipt_note_line_id") @db.Uuid

  quantity      Decimal @db.Decimal(18, 6)
  unitPriceKobo BigInt  @map("unit_price_kobo")

  taxCodeId     String? @map("tax_code_id") @db.Uuid
  netAmountKobo BigInt  @map("net_amount_kobo")
  vatAmountKobo BigInt  @default(0) @map("vat_amount_kobo")

  /// Which GL account the cost side hits. For a GRN-matched line this is the
  /// GRNI account being cleared; for an unmatched line it is inventory or
  /// expense directly.
  costGlAccountId String  @map("cost_gl_account_id") @db.Uuid
  /// True when this line clears GRNI rather than debiting inventory afresh —
  /// the distinction that stops inventory being recognised twice.
  clearsGrni      Boolean @default(false) @map("clears_grni")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice           SupplierInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item              Item                  @relation(fields: [itemId], references: [id])
  purchaseOrderLine PurchaseOrderLine?    @relation(fields: [purchaseOrderLineId], references: [id])
  goodsReceiptLine  GoodsReceiptNoteLine? @relation(fields: [goodsReceiptNoteLineId], references: [id])
  taxCode           TaxCode?              @relation("SupplierInvoiceLineTaxCode", fields: [taxCodeId], references: [id])
  costAccount       GLAccount             @relation("SupplierInvoiceLineCostAccount", fields: [costGlAccountId], references: [id])

  @@unique([invoiceId, lineNumber])
  @@map("supplier_invoice_lines")
}

// ---------------------------------------------------------------------------
// §5 Supplier Payment
// ---------------------------------------------------------------------------

model SupplierPayment {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @map("company_id") @db.Uuid
  paymentNumber String @map("payment_number")
  supplierId    String @map("supplier_id") @db.Uuid

  paymentDate DateTime      @map("payment_date") @db.Date
  method      PaymentMethod

  bankGlAccountId String  @map("bank_gl_account_id") @db.Uuid
  reference       String?
  narration       String?

  branchId          String @map("branch_id") @db.Uuid
  currencyId        String @map("currency_id") @db.Uuid
  financialYearId   String @map("financial_year_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid

  /// MONEY. `amountKobo` is what leaves the bank; the withheld and discount
  /// amounts make up the rest of what the payables balance is relieved by.
  amountKobo    BigInt @map("amount_kobo")
  whtAmountKobo BigInt @default(0) @map("wht_amount_kobo")
  discountKobo  BigInt @default(0) @map("discount_kobo")

  whtTaxCodeId String? @map("wht_tax_code_id") @db.Uuid

  status PaymentStatus @default(DRAFT)

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company         Company             @relation(fields: [companyId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  bankAccount     GLAccount           @relation("PaymentBankAccount", fields: [bankGlAccountId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  currency        Currency            @relation(fields: [currencyId], references: [id])
  financialYear   FinancialYear       @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod     @relation(fields: [financialPeriodId], references: [id])
  whtTaxCode      TaxCode?            @relation("PaymentWhtCode", fields: [whtTaxCodeId], references: [id])
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  createdBy       User                @relation("PaymentCreator", fields: [createdById], references: [id])
  allocations     PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId, status])
  @@map("supplier_payments")
}

model PaymentAllocation {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  /// MONEY. How much of this payment settles this invoice.
  amountKobo BigInt @map("amount_kobo")

  createdAt DateTime @default(now()) @map("created_at")

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Period-End & Year-End Closing  (Consolidated Reference §8 — Phase 11)
//
// Built last because it depends on every other module being able to post
// correctly — which, eight phases in, they demonstrably can.
//
// §8's developer notes, and where each lands:
//   1. "Year-End Close Wizard must run as a single controlled transaction —
//      any validation failure rolls back completely, never partially closes."
//      -> YearEndService.close() is one database transaction end to end.
//   2. "New year's opening balances generate automatically from prior year's
//      closing balances." -> the roll-forward, which nets revenue and expense
//      into retained earnings rather than carrying them forward.
//   3. "Period close/reopen/year-end close all go through the Workflow Engine."
//   4. "Every close/reopen is an immutable audit record."
//   5. "Must be reusable across SnailPro, PoultryPro and future products."
//      -> nothing here names a module or a species.
//
// The Phase 1 schema already carries FinancialYear, FinancialPeriod and their
// statuses, and PeriodService already gates postings on them. This section adds
// what §8 asks for beyond that: the checklist, the logs, and the balances that
// carry a year forward.
// ---------------------------------------------------------------------------

enum ChecklistItemStatus {
  PENDING
  COMPLETE
  /// Deliberately passed over, with a reason. Not the same as done.
  WAIVED
  FAILED
}

enum CloseAction {
  OPEN
  SOFT_CLOSE
  CLOSE
  REOPEN
  YEAR_END_CLOSE
  ROLL_FORWARD
}

/// A step that must be settled before a period can close.
///
/// Configuration, so a company adds a step without a migration. `blocking`
/// separates "you cannot close until this is done" from "look at this first" —
/// a checklist where everything blocks is a checklist people learn to waive.
model PeriodCloseChecklistTemplate {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  code        String
  name        String
  description String?
  sequence    Int

  blocking         Boolean @default(true)
  /// Applies to a year-end close as well as a period close.
  appliesToYearEnd Boolean @default(false) @map("applies_to_year_end")

  /// An automated check this step maps to, where one exists. Null means the
  /// step is confirmed by a human.
  automatedCheck String? @map("automated_check")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company                @relation(fields: [companyId], references: [id])
  items   PeriodCloseChecklist[]

  @@unique([companyId, code])
  @@map("period_close_checklist_templates")
}

/// One checklist step against one period, as it was actually settled.
model PeriodCloseChecklist {
  id                String @id @default(uuid()) @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid
  templateId        String @map("template_id") @db.Uuid

  status ChecklistItemStatus @default(PENDING)

  /// Set when an automated check ran, with what it found.
  checkResult Json? @map("check_result")

  completedById String?   @map("completed_by_id") @db.Uuid
  completedAt   DateTime? @map("completed_at")
  /// Required when waiving. A step passed over without a reason is a step
  /// nobody can review afterwards.
  comments      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  financialPeriod FinancialPeriod              @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  template        PeriodCloseChecklistTemplate @relation(fields: [templateId], references: [id])
  completedBy     User?                        @relation("ChecklistCompleter", fields: [completedById], references: [id])

  @@unique([financialPeriodId, templateId])
  @@map("period_close_checklists")
}

/// Every close, soft close, reopen and year-end action. Append-only (§8 note 4).
model PeriodCloseLog {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  financialYearId   String  @map("financial_year_id") @db.Uuid
  financialPeriodId String? @map("financial_period_id") @db.Uuid

  action     CloseAction
  fromStatus String?     @map("from_status")
  toStatus   String      @map("to_status")

  /// MONEY. The trial balance at the moment of the action, so a closed period's
  /// figures can be reproduced without re-deriving them from a ledger that has
  /// moved on.
  totalDebitKobo  BigInt @default(0) @map("total_debit_kobo")
  totalCreditKobo BigInt @default(0) @map("total_credit_kobo")

  /// The checklist and validation state at the time, for the same reason.
  snapshot Json?

  reason        String?
  performedById String   @map("performed_by_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")
  ipAddress     String?  @map("ip_address")
  device        String?

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id])
  financialYear   FinancialYear    @relation(fields: [financialYearId], references: [id])
  financialPeriod FinancialPeriod? @relation(fields: [financialPeriodId], references: [id])
  performedBy     User             @relation("CloseLogActor", fields: [performedById], references: [id])

  @@index([companyId, occurredAt])
  @@index([financialYearId, action])
  @@map("period_close_logs")
}

/// A year's closing balance per account, and the next year's opening balance.
///
/// One table for both: an opening balance IS the prior year's closing balance,
/// and storing them separately would create two numbers that have to agree.
model AccountBalance {
  id              String @id @default(uuid()) @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  financialYearId String @map("financial_year_id") @db.Uuid
  glAccountId     String @map("gl_account_id") @db.Uuid

  /// True for the opening position of the year, false for its close.
  isOpening Boolean @map("is_opening")

  /// MONEY, integer kobo. Both sides retained rather than a net, so the
  /// roll-forward can be checked against the ledger it came from.
  totalDebitKobo  BigInt @map("total_debit_kobo")
  totalCreditKobo BigInt @map("total_credit_kobo")
  /// Signed by the account's normal balance, as the trial balance presents it.
  balanceKobo     BigInt @map("balance_kobo")

  /// The journal that carried this balance forward, for opening rows.
  journalEntryId String? @map("journal_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])
  glAccount     GLAccount     @relation(fields: [glAccountId], references: [id])
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([financialYearId, glAccountId, isOpening])
  @@index([companyId, financialYearId])
  @@map("account_balances")
}

/// §8 lists a Period Reopen Request as its own document. Reopening a closed
/// period is the single most sensitive action in this module — it lets figures
/// already reported change — so it carries its own reason and its own approval
/// rather than riding on a status update.
model PeriodReopenRequest {
  id                String @id @default(uuid()) @db.Uuid
  companyId         String @map("company_id") @db.Uuid
  financialPeriodId String @map("financial_period_id") @db.Uuid

  reason        String
  requestedById String   @map("requested_by_id") @db.Uuid
  requestedAt   DateTime @default(now()) @map("requested_at")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  /// Set once the period has actually been reopened, so a granted request that
  /// was never acted on is distinguishable from one that was.
  reopenedAt   DateTime? @map("reopened_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company         @relation(fields: [companyId], references: [id])
  financialPeriod FinancialPeriod @relation(fields: [financialPeriodId], references: [id])
  requestedBy     User            @relation("ReopenRequester", fields: [requestedById], references: [id])
  approvedBy      User?           @relation("ReopenApprover", fields: [approvedById], references: [id])

  @@index([companyId, financialPeriodId])
  @@map("period_reopen_requests")
}

// ---------------------------------------------------------------------------
// Operations — the livestock, and what happens to it
//
// Everything above this line is the accounting spine: ledger, tax, payroll,
// procurement, sales, close. None of it knew what a farm actually keeps. The
// web app has screens that record real work — the daily round, treatments,
// harvests, stage changes, placements — and until now every one of them queued
// its work in the browser with nowhere to send it.
//
// Rule 8 holds throughout: the species lives in the DATA. There is no poultry
// table and no snail table, no enum listing them, and nothing here that would
// have to change to add fish. A batch of broilers and a colony of snails are
// the same row with a different `speciesKey`, and the words a user sees come
// from the module registry in the web app, not from a column name.
//
// Conventions carried from the sections above: money is integer kobo in a
// BigInt, quantities that can be fractional are Decimal, and counts of animals
// are Int — half a bird is not a thing.
// ---------------------------------------------------------------------------

/// A species or breed a company is licensed to keep, with the age at which it
/// reaches each lifecycle stage (§ SNAIL_SPECIES_MASTER / POULTRY_BREED_MASTER).
///
/// Rule 8 still holds: one table, not a snail table and a poultry table. Snail
/// rows use `name` for the scientific name and `classification` for the common
/// name; poultry rows use `name` for the breed/strain and `classification` for
/// the production class — same columns, different words, exactly like
/// LivestockGroup's own `breed`/`purpose`.
///
/// Governs `LivestockGroup.speciesKey` (must be a company's own module) but
/// deliberately does NOT block `LivestockGroup.breed` against this list on
/// placement — the workbook's own age tracker reports an unrecognised
/// stage as REVIEW, not a rejection, and farms keep breeds nobody put in a
/// registry. Age-eligibility gates that DO refuse a request (stage transfer,
/// sale) read `SpeciesBreedStage` explicitly where that matters.
model SpeciesBreed {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Which species module this belongs to — 'poultry', 'snail', 'fish'. Same
  /// key as LivestockGroup.speciesKey.
  speciesKey String @map("species_key")

  /// The workbook's own code — SNL-AM, BR-BROIL-01. Unique within the module.
  code String

  /// Scientific name (snail) or breed/strain (poultry).
  name String

  /// Common name (snail) or production class — Broiler/Layer/Breeder (poultry).
  classification String?

  openingStage String @map("opening_stage")

  /// Free text, not an enum (Rule 8) — Active/Restricted/Controlled/Country
  /// configuration, straight from the workbook's own Status column.
  status String @default("Active")

  /// The workbook's own governance caveat — e.g. "Illustrative age
  /// thresholds—specialist approval required".
  controlNote String? @map("control_note")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company             @relation(fields: [companyId], references: [id])
  stages  SpeciesBreedStage[]

  @@unique([companyId, speciesKey, code])
  @@index([companyId, speciesKey])
  @@map("species_breeds")
}

/// One lifecycle stage's minimum age, in days, for a SpeciesBreed — the
/// workbook's "Hatchling min day" / "Stage 1 min day" columns turned into
/// rows so a breed with five stages and one with four are the same shape.
model SpeciesBreedStage {
  id             String @id @default(uuid()) @db.Uuid
  speciesBreedId String @map("species_breed_id") @db.Uuid

  /// Must match a stage the module registry actually declares for this
  /// species (e.g. "Juvenile") — validated at write time, not by a DB enum.
  stageName String @map("stage_name")
  minDay    Int    @map("min_day")
  sortOrder Int    @map("sort_order")

  speciesBreed SpeciesBreed @relation(fields: [speciesBreedId], references: [id], onDelete: Cascade)

  @@unique([speciesBreedId, stageName])
  @@map("species_breed_stages")
}

enum LivestockGroupStatus {
  ACTIVE
  /// Sold out, harvested out, or otherwise finished. Kept forever: a closed
  /// batch is where the profit of a completed cycle is measured.
  CLOSED
}

/// A managed population — a poultry batch, a snail colony, a pond of fish.
///
/// The cost object the whole product turns on. Feed issued to it, treatments
/// given to it and losses from it accumulate here, which is what makes "did
/// this batch make money" answerable rather than estimated.
model LivestockGroup {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid
  farmId     String @map("farm_id") @db.Uuid
  /// Where it is kept now. Moves when a stage change moves it.
  penHouseId String @map("pen_house_id") @db.Uuid

  /// The farm's own reference — B-2026-007, S-004. Unique within the company
  /// because that is how people refer to it out loud.
  code String

  /// Which species module this belongs to: 'poultry', 'snail', 'fish'.
  /// A string rather than an enum, on purpose — see Rule 8 above.
  speciesKey String @map("species_key")

  breed   String
  /// What it is kept for: Layer, Broiler, Breeder colony, Growers.
  purpose String
  /// Where it is in its life: Chick, Grower, Layer, Juvenile, Breeder.
  /// Values come from the module registry, so they are data too.
  stage   String

  /// How many arrived. Never changes — it is the denominator of every
  /// cumulative mortality figure this population will ever have.
  openingPopulation Int @map("opening_population")

  /// How many are alive now.
  ///
  /// A materialised balance, in the same spirit as AccountBalance above: it is
  /// only ever moved inside the same transaction as the event that moved it —
  /// a mortality record, a harvest, a livestock sale. Nothing may set it
  /// directly. Kept rather than derived because every screen in the product
  /// shows it, and summing an entire history on each read would be the slowest
  /// query in the application.
  population Int

  startedOn DateTime  @map("started_on") @db.Date
  closedOn  DateTime? @map("closed_on") @db.Date

  /// US-897-004/005. Planned dates, set at placement — this app has no
  /// "edit a group" screen yet, so these are captured once rather than
  /// left unbuildable pending one. Null means none was planned.
  expectedTransferDate DateTime? @map("expected_transfer_date") @db.Date
  expectedHarvestDate  DateTime? @map("expected_harvest_date") @db.Date

  /// US-897-004/005's "ongoing current weight", distinct from
  /// HarvestRecord's own weight-at-harvest. A materialised balance — the
  /// same pattern as `population` — updated whenever a daily round records
  /// a 'weightKg' ProductionLine measure for this group. Null until the
  /// first one lands.
  currentWeightKg Decimal? @map("current_weight_kg") @db.Decimal(18, 6)

  status LivestockGroupStatus @default(ACTIVE)

  /// Who supplied the stock. Free text: a farm buys day-olds from a hatchery
  /// it will not find in a supplier master.
  source String?

  /// MONEY. What the stock itself cost to acquire, in kobo.
  acquisitionCostKobo BigInt @default(0) @map("acquisition_cost_kobo")

  /// The IAS 41 carrying value per live unit, in kobo. Null until the first
  /// acquisition or valuation posts. A materialised balance in the same
  /// spirit as `population` — moved only inside the transaction of the
  /// posting that changed it, never set directly.
  currentFvlctsPerUnitKobo BigInt? @map("current_fvlcts_per_unit_kobo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  farm     Farm     @relation(fields: [farmId], references: [id])
  penHouse PenHouse @relation("GroupPenHouse", fields: [penHouseId], references: [id])

  dailyRecords DailyRecord[]
  healthEvents HealthEvent[]
  treatments   TreatmentRecord[]
  harvests     HarvestRecord[]
  harvestsInto HarvestRecord[]            @relation("HarvestMovedTo")
  stageChanges StageChange[]
  valuations   BiologicalAssetValuation[]
  disposals    LivestockGroupDisposal[]
  productionOrders ProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId, speciesKey, status])
  @@index([penHouseId])
  @@map("livestock_groups")
}

/// A population leaving live — §61.3 formula 6, PCR-050/073.
///
/// `trade.service.ts` decrements `LivestockGroup.population` the moment a
/// sale is recorded, but that alone has no accounting consequence: nothing
/// removed the carrying value the animals took with them, which is exactly
/// why `rollForward()`'s reconciliation never closed for a population that
/// had been sold. This is the disposal-carrying-amount side of that formula,
/// captured the same way `MortalityRecord` captures its own: the FVLCTS rate
/// in force AT THE MOMENT of disposal, so a later revaluation cannot rewrite
/// what was actually posted.
model LivestockGroupDisposal {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @map("group_id") @db.Uuid

  /// COUNT. Whole animals.
  quantity Int

  /// MONEY. The group's `currentFvlctsPerUnitKobo` at the moment of disposal.
  fvlctsPerUnitKobo  BigInt @map("fvlcts_per_unit_kobo")
  /// MONEY. quantity x fvlctsPerUnitKobo — what PCR-050/073 posts to COGS.
  carryingAmountKobo BigInt @map("carrying_amount_kobo")

  occurredOn DateTime @map("occurred_on") @db.Date

  journalEntryId String? @map("journal_entry_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  group        LivestockGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry?  @relation("LivestockDisposalJournal", fields: [journalEntryId], references: [id])

  @@index([groupId])
  @@map("livestock_group_disposals")
}

/// One population, one day: what it ate, what it produced, what it lost.
///
/// The daily round walks the houses and records exactly this per stop, so the
/// shape matches the walk rather than the database's convenience. One row per
/// population per day — recording the same day twice is a correction, not a
/// second row, which is what the unique constraint enforces.
model DailyRecord {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  recordedOn DateTime @map("recorded_on") @db.Date

  /// True when the figures were carried over from yesterday rather than
  /// observed. Kept because a carried-over number is weaker evidence than a
  /// counted one, and a variance check that cannot tell them apart will chase
  /// its own tail.
  carriedOver Boolean @default(false) @map("carried_over")

  notes String?

  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company           @relation(fields: [companyId], references: [id])
  group      LivestockGroup    @relation(fields: [groupId], references: [id])
  recordedBy User              @relation("DailyRecordRecorder", fields: [recordedById], references: [id])
  production ProductionLine[]
  feedIssues FeedIssue[]
  mortality  MortalityRecord[]

  @@unique([groupId, recordedOn])
  @@index([companyId, recordedOn])
  @@map("daily_records")
}

/// What a population produced, one line per measure.
///
/// Key/value rather than columns, because what gets counted is configuration:
/// poultry records whole eggs and cracked eggs, snails record harvest weight,
/// dairy records litres. A table with an `eggs` column would be a species named
/// in the schema, and the next module would need a migration to exist.
model ProductionLine {
  id            String @id @default(uuid()) @db.Uuid
  dailyRecordId String @map("daily_record_id") @db.Uuid

  /// The module registry's field key — 'wholeEggs', 'cracked', 'weightKg'.
  fieldKey String  @map("field_key")
  /// QUANTITY. Decimal because some measures are weights.
  quantity Decimal @db.Decimal(18, 6)

  dailyRecord DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)

  @@unique([dailyRecordId, fieldKey])
  @@map("production_lines")
}

/// Feed issued to a population.
///
/// The single largest cost on a poultry farm, and the reason feed-per-head is
/// the sharpest theft signal the product has.
model FeedIssue {
  id            String @id @default(uuid()) @db.Uuid
  dailyRecordId String @map("daily_record_id") @db.Uuid

  /// The stock item, once the feed is a real inventory item. Nullable while a
  /// farm is still typing the name of a feed it buys in bags from the market.
  itemId   String? @map("item_id") @db.Uuid
  /// What the worker chose, as they chose it — 'Broiler finisher'.
  feedName String  @map("feed_name")

  /// QUANTITY in kilograms.
  quantityKg Decimal @map("quantity_kg") @db.Decimal(18, 6)

  /// MONEY. Integer kobo, at the cost the stock was issued at.
  unitCostKobo BigInt @default(0) @map("unit_cost_kobo")
  valueKobo    BigInt @default(0) @map("value_kobo")

  /// The posting that took this out of stock and into the population's
  /// work-in-progress. Null until it has been posted.
  journalEntryId String? @map("journal_entry_id") @db.Uuid

  dailyRecord  DailyRecord   @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  item         Item?         @relation("FeedIssueItem", fields: [itemId], references: [id])
  journalEntry JournalEntry? @relation("FeedIssueJournal", fields: [journalEntryId], references: [id])

  @@index([dailyRecordId])
  @@map("feed_issues")
}

/// Animals lost, and what the worker believed killed them.
model MortalityRecord {
  id            String @id @default(uuid()) @db.Uuid
  dailyRecordId String @map("daily_record_id") @db.Uuid

  /// COUNT. Whole animals.
  quantity Int

  /// More than one is allowed: a die-off is rarely one thing, and forcing a
  /// single cause produces a confident answer nobody checked.
  causes String[]

  /// §67.4's threshold test, decided at posting time against
  /// `BiologicalAssetConfiguration`. Not user-selected — a worker records
  /// what died, not whether it counts as a normal loss.
  classification MortalityClassification @default(NORMAL)
  journalEntryId String?                 @map("journal_entry_id") @db.Uuid

  notes String?

  dailyRecord  DailyRecord      @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  photos       MortalityPhoto[]
  journalEntry JournalEntry?    @relation("MortalityJournal", fields: [journalEntryId], references: [id])
  stageChange  StageChange?

  @@index([dailyRecordId])
  @@map("mortality_records")
}

/// A photograph attached to a mortality record.
///
/// Its own table so the image never rides along with a query that only wanted
/// the numbers. The bytes are held inline today because there is no object
/// store yet; `storageKey` is the seam for moving them out, at which point
/// `data` becomes null and nothing else has to change.
model MortalityPhoto {
  id                String @id @default(uuid()) @db.Uuid
  mortalityRecordId String @map("mortality_record_id") @db.Uuid

  fileName   String  @map("file_name")
  mimeType   String  @map("mime_type")
  byteSize   Int     @map("byte_size")
  /// Base64, as captured and downscaled by the phone.
  data       String? @db.Text
  storageKey String? @map("storage_key")

  createdAt DateTime @default(now()) @map("created_at")

  mortalityRecord MortalityRecord @relation(fields: [mortalityRecordId], references: [id], onDelete: Cascade)

  @@index([mortalityRecordId])
  @@map("mortality_photos")
}

enum HealthEventStatus {
  DUE
  OVERDUE
  DONE
  /// Deliberately not given — a vet stood the batch down, or the programme
  /// changed. Distinct from DONE so coverage figures stay honest.
  SKIPPED
}

/// A treatment that is scheduled — a vaccination on a programme.
///
/// Separate from the record of it being given, because the two are genuinely
/// different facts: one is a plan, the other is evidence. Keeping them in one
/// row means a missed vaccination becomes indistinguishable from one that was
/// never scheduled.
model HealthEvent {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  /// VACCINATION, TREATMENT, INCIDENT. A string because a farm may have kinds
  /// nobody put in an enum.
  kind   String
  name   String
  detail String?

  dueOn  DateTime          @map("due_on") @db.Date
  status HealthEventStatus @default(DUE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company           @relation(fields: [companyId], references: [id])
  group      LivestockGroup    @relation(fields: [groupId], references: [id])
  treatments TreatmentRecord[]

  @@index([companyId, status, dueOn])
  @@index([groupId, dueOn])
  @@map("health_events")
}

/// A treatment actually given.
///
/// Carries the two things a tick-box would lose: how many animals it reached,
/// and the withdrawal period. Partial coverage is recorded as it happened
/// rather than rounded up to "done", and the withdrawal days come off the
/// product label — this schema does not know them and must not invent them.
model TreatmentRecord {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  /// The scheduled event this satisfies. Null for an unscheduled treatment —
  /// animals get sick between vaccination dates.
  healthEventId String? @map("health_event_id") @db.Uuid

  name    String
  givenOn DateTime @map("given_on") @db.Date
  /// How it was administered: in drinking water, injection, spray.
  route   String
  /// Free text rather than a user link: the person who gave it is often not a
  /// system user, and naming the wrong one is worse than naming a string.
  givenBy String   @map("given_by")

  /// COUNT reached, and the population at the time. Both, because coverage is
  /// the ratio and the denominator moves.
  treatedCount     Int @map("treated_count")
  populationAtTime Int @map("population_at_time")

  /// The bottle's batch number, for tracing a bad batch later.
  productBatch String? @map("product_batch")

  /// Days after which produce may be sold again, taken from the product label,
  /// and the date that implies. Zero means none was stated.
  withdrawalDays Int       @default(0) @map("withdrawal_days")
  safeToSellFrom DateTime? @map("safe_to_sell_from") @db.Date

  /// MONEY. What it cost, in kobo, against this population.
  costKobo BigInt @default(0) @map("cost_kobo")

  notes String?

  journalEntryId String? @map("journal_entry_id") @db.Uuid

  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  company      Company        @relation(fields: [companyId], references: [id])
  group        LivestockGroup @relation(fields: [groupId], references: [id])
  healthEvent  HealthEvent?   @relation(fields: [healthEventId], references: [id])
  recordedBy   User           @relation("TreatmentRecorder", fields: [recordedById], references: [id])
  journalEntry JournalEntry?  @relation("TreatmentJournal", fields: [journalEntryId], references: [id])

  @@index([companyId, givenOn])
  @@index([groupId, givenOn])
  @@map("treatment_records")
}

/// What came off a population.
///
/// NOT a sale. A harvest moves cost out of the population's work-in-progress
/// and into finished goods; the revenue happens later, at a price nobody knows
/// yet. There is deliberately no price column — putting one here would
/// recognise profit at the moment of picking.
model HarvestRecord {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  harvestedOn DateTime @map("harvested_on") @db.Date
  grade       String

  /// QUANTITY in kilograms, and the COUNT of animals it removed. The count is
  /// recorded rather than inferred from weight — animals per kilo varies with
  /// size, breed and season, so inferring it would corrupt the population that
  /// every mortality rate is measured against.
  weightKg Decimal @map("weight_kg") @db.Decimal(18, 6)
  count    Int

  populationAtTime Int @map("population_at_time")

  /// Where it went. Either into stock, or back into another population as
  /// breeding stock — in which case `movedToGroupId` is set.
  destination    String
  movedToGroupId String? @map("moved_to_group_id") @db.Uuid

  notes String?

  journalEntryId String? @map("journal_entry_id") @db.Uuid

  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  company      Company         @relation(fields: [companyId], references: [id])
  group        LivestockGroup  @relation(fields: [groupId], references: [id])
  movedToGroup LivestockGroup? @relation("HarvestMovedTo", fields: [movedToGroupId], references: [id])
  recordedBy   User            @relation("HarvestRecorder", fields: [recordedById], references: [id])
  journalEntry JournalEntry?   @relation("HarvestJournal", fields: [journalEntryId], references: [id])
  productionOrder ProductionOrder?

  @@index([companyId, harvestedOn])
  @@index([groupId, harvestedOn])
  @@map("harvest_records")
}

/// A population moving to the next stage of its life.
///
/// Records the move and nothing else. It does NOT change the count — a pullet
/// becoming a layer is the same bird — and it does not split a population,
/// because apportioning accumulated cost between the halves is a decision no
/// schema should make silently.
model StageChange {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  changedOn DateTime @map("changed_on") @db.Date

  fromStage String @map("from_stage")
  toStage   String @map("to_stage")

  /// Houses move with the stage often enough to record both; the two are equal
  /// when the population stayed put.
  fromPenHouseId String @map("from_pen_house_id") @db.Uuid
  toPenHouseId   String @map("to_pen_house_id") @db.Uuid

  /// The count at the START of the move — what postStageTransfer() values
  /// and moves into the destination stage account. Was framed as "evidence
  /// it did not change" before mortalityCount existed; a move can now cost
  /// lives in transit, so this is the pre-loss figure, not a claim nothing
  /// changed.
  population Int

  /// COUNT lost during the move itself — 0 in the common case (nothing
  /// died in transit). When set, a real MortalityRecord is created and
  /// posted through the same governed BiologicalAssetService.postMortality()
  /// path daily-round mortality already uses (threshold classification,
  /// FVLCTS valuation, a real journal) — not a separate unposted number.
  mortalityCount Int @default(0) @map("mortality_count")

  notes String?

  recordedById      String   @map("recorded_by_id") @db.Uuid
  journalEntryId    String?  @map("journal_entry_id") @db.Uuid
  mortalityRecordId String?  @unique @map("mortality_record_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company         Company          @relation(fields: [companyId], references: [id])
  group           LivestockGroup   @relation(fields: [groupId], references: [id])
  fromPenHouse    PenHouse         @relation("StageChangeFrom", fields: [fromPenHouseId], references: [id])
  toPenHouse      PenHouse         @relation("StageChangeTo", fields: [toPenHouseId], references: [id])
  recordedBy      User             @relation("StageChangeRecorder", fields: [recordedById], references: [id])
  journalEntry    JournalEntry?    @relation("StageChangeJournal", fields: [journalEntryId], references: [id])
  mortalityRecord MortalityRecord? @relation(fields: [mortalityRecordId], references: [id])

  @@index([companyId, changedOn])
  @@index([groupId, changedOn])
  @@map("stage_changes")
}

/// An invitation to join a farm that already exists.
///
/// Signing up creates a company. This is the other half: a farm manager adding
/// the people who work for them, who must land INSIDE that company rather than
/// creating one of their own. Without it every worker who needed an account
/// would sign up as an owner and end up in a farm of one, looking at an empty
/// dashboard and wondering where the birds went.
///
/// The token is stored HASHED, never in the clear. The raw value exists only in
/// the link that is handed to the person; anybody reading this table — a
/// backup, a support query, a leaked dump — gets a hash they cannot use. Same
/// reasoning as a password, for the same reason: this token is a credential,
/// and for a short while it is enough on its own to join a company.
model Invitation {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Who it was sent to. Not unique: an invitation can be resent, and a person
  /// who leaves and returns should not be blocked by their own history.
  email String
  /// What they will be able to do once they accept.
  roles String[]

  /// SHA-256 of the token in the link. Unique so a token identifies one
  /// invitation and lookups do not need a scan.
  tokenHash String @unique @map("token_hash")

  invitedById String   @map("invited_by_id") @db.Uuid
  /// Invitations rot on purpose. A link that works forever is a credential
  /// nobody remembers issuing, sitting in an inbox somebody else may inherit.
  expiresAt   DateTime @map("expires_at")

  acceptedAt     DateTime? @map("accepted_at")
  acceptedUserId String?   @map("accepted_user_id") @db.Uuid
  /// Withdrawn before it was used. Kept rather than deleted so "who invited
  /// this person, and who cancelled it" stays answerable.
  revokedAt      DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  invitedBy User    @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([companyId, email])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Posting control (Consolidated Reference §66)
//
// The rule the specification is most insistent about, and the one this system
// broke for longest: "A transaction user must never type a GL account. The
// approved business event selects debit and credit posting keys; the system
// retrieves both GL code and GL name from POSTING_COA_MASTER, validates the
// Ledger Flag, dimensions, period and approval, and then posts one balanced
// atomic journal."
//
// Until these tables existed, every posting in this application named its
// accounts in TypeScript. That is not a style question. A rule written in code
// cannot be effective-dated, cannot be approved by a Financial Controller,
// cannot be retired, and cannot be audited without reading a diff — and the
// specification requires all four. It also meant nothing enforced the Ledger
// Flag, so a manual journal could be posted straight to GRNI or to a payables
// control account, which is precisely the hole the flag exists to close.
//
// The 86 rules and 172 keys seeded into these tables are the client's own rows,
// extracted from the workbook rather than retyped.
// ---------------------------------------------------------------------------

enum PostingKeySide {
  DEBIT
  CREDIT
}

/// §66.3. What may write to an account, and from where.
enum LedgerFlag {
  /// AP, AR, GRNI, inventory, biological assets, WIP, recovery, payroll and
  /// similar control ledgers. Manual journals are blocked outright; only the
  /// owning subledger or system process may post.
  CONTROL
  /// Revenue, expense, gain, loss, variance. A role-authorised, open-period,
  /// balanced, dimensioned journal is allowed.
  GENERAL
  /// Workflow and commitment events that create no accounting at all — a
  /// requisition approval, a purchase order, activating a period.
  NO_JOURNAL
}

enum PostingRuleStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// One row of POSTING_COA_MASTER: a posting key and the account it resolves to.
model PostingKey {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// The key a rule refers to, e.g. `PCR-004-DR`.
  key String

  /// The account code as the workbook states it.
  ///
  /// Not always a single static account. Thirty-two of the 172 keys carry a
  /// dynamic expression instead — "Species BA acquisition GL", "210100/210200",
  /// "1302xx" — meaning WHICH account applies depends on something about the
  /// transaction (which stage a population is in, which item is being sold,
  /// which journal is being reversed), not on a client decision still owed.
  /// §66.2 step 4 requires this generic table-driven resolver to BLOCK when it
  /// cannot reduce a key to one atomic account — correctly, since guessing
  /// would put money in an account nobody approved — but roughly a third of
  /// these are already resolved for real, just not by this resolver: see
  /// `dynamicResolution` below. `atomic` records only what THIS declarative
  /// table can do; it is not the last word on whether a rule can post.
  glAccountCode String? @map("gl_account_code")
  glAccountName String  @map("gl_account_name")

  /// The resolved account, where the code names exactly one that exists.
  glAccountId String? @map("gl_account_id") @db.Uuid

  /// False when the code is an expression, a range, or a choice between
  /// accounts. Posting through such a key is refused rather than guessed BY
  /// THIS resolver — see `dynamicResolution` for keys where a different,
  /// dedicated service already resolves it correctly per transaction.
  atomic Boolean @default(false)

  /// Where a non-atomic key's real account actually comes from, when it does.
  ///
  /// `PostingControlService.resolve()` is consulted only by the release gate
  /// and the posting-rules register — no domain service posts through it. Every
  /// real transaction (biological assets, sales, procurement, year end) resolves
  /// its own accounts and calls the one shared `PostingService.post()` directly.
  /// For roughly a third of the 32 non-atomic keys, that dedicated resolution
  /// already exists and is tested; this field names it, so the release gate can
  /// tell "already resolved elsewhere" apart from "genuinely needs the client to
  /// choose an account" instead of reporting both as the same kind of blocked.
  /// Null means no dedicated resolution exists yet — the honest, still-blocked
  /// case, either because a client decision is genuinely owed or because the
  /// module that would consume it (feed mill, processing, ABC costing) is not
  /// built yet.
  dynamicResolution String? @map("dynamic_resolution")

  allowedModule String         @map("allowed_module")
  cycle         String
  side          PostingKeySide
  ledgerFlag    LedgerFlag     @map("ledger_flag")

  /// Draft keys cannot post (§66.4).
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  glAccount GLAccount? @relation("PostingKeyAccount", fields: [glAccountId], references: [id])

  @@unique([companyId, key])
  @@index([companyId, active])
  @@map("posting_keys")
}

/// One row of Posting_Control: a business event and the keys it posts through.
model PostingRule {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// e.g. `PCR-004`.
  ruleId String @map("rule_id")

  module   String
  cycle    String
  sequence Int    @default(0)

  /// The screen or event that fires it, and what document it comes from.
  trigger        String
  sourceDocument String @map("source_document")
  scenario       String

  debitKey  String @map("debit_key")
  creditKey String @map("credit_key")

  /// How the amount is arrived at, e.g. "Accepted quantity × PO price/WAC basis".
  measurementBasis String @map("measurement_basis")

  /// Semicolon-separated, as the workbook states them. Free text rather than a
  /// relation because the dimension vocabulary is the client's, not ours, and
  /// pinning it to our enum would silently drop any dimension we lack.
  requiredDimensions String @map("required_dimensions")

  makerRole    String @map("maker_role")
  approverRole String @map("approver_role")

  /// What must be true before this rule may post.
  blockingControl String @map("blocking_control")
  /// How a posting made under this rule is corrected. Never by editing it.
  reversalMethod  String @map("reversal_method")
  reportImpact    String @map("report_impact")

  /// Draft and retired rules cannot post (§66.2 step 2).
  status PostingRuleStatus @default(DRAFT)

  /// Effective dating, so correcting a rule is a new version rather than an
  /// edit to one that has already posted.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  version       Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, ruleId, version])
  @@index([companyId, status, effectiveFrom])
  @@index([companyId, module, cycle])
  @@map("posting_rules")
}

// ---------------------------------------------------------------------------
// Biological assets (Consolidated Reference §43, §61, §67 — IAS 41)
//
// The gap the client demonstrated in his own voice note: "as soon as I receive
// the snail into the inventory... the biological asset is debited and the
// Goods Received Not Yet Invoiced is credited." Nothing in this codebase did
// that. `LivestockGroup` already tracked a population and its acquisition
// cost; nothing turned either into a ledger entry, and `operations-posting
// .service.ts` said plainly why: valuing a dead or growing animal is a policy
// decision, not a fact, and guessing at one would put an unapproved number in
// the accounts.
//
// The workbook supplies the policy: fair value less costs to sell (§61.7),
// with seven stated formulas (§61.3) for quantity roll-forward, mortality
// carrying loss, growth/price gain and closing carrying value. That is what
// is implemented below — not a new costing method invented here.
//
// Two things this deliberately does NOT do.
//
// It does not invent a "Market-ready" stage for snails. The product's own
// stage vocabulary (apps/web/src/lib/modules.ts) is Egg, Hatchling, Juvenile,
// Grower, Breeder — it has no stage matching the workbook's separate
// 130204 "BA — Market Snails" account, because harvest/sale in this product
// happens directly from Grower via `HarvestRecord`, not through a stage
// transition. `BiologicalAssetStageAccount` maps what the product actually has;
// 130204 sits unmapped until that product decision is made.
//
// It does not decide the abnormal-mortality threshold. §67.4 requires a
// "threshold test", not a free human choice, but the percentage itself is not
// stated anywhere in the workbook — it is site policy, the same way the
// approval ladder is. `BiologicalAssetConfiguration` carries a provisional
// default, exactly as the workflow ladder does, pending the client's figure.
// ---------------------------------------------------------------------------

enum MortalityClassification {
  NORMAL
  ABNORMAL
}

/// §61.3 formula 3/4: whether a valuation event raised or lowered carrying value.
enum ValuationDirection {
  GAIN
  LOSS
}

/// The GL account a lifecycle stage carries its biological asset in.
///
/// Explicit, seeded, editable data rather than logic — the same reason
/// `PostingKey` exists rather than a switch statement. Species differ
/// structurally: snail has five stage accounts (130200-130204); poultry
/// carries almost every stage in one account (130210) with eggs split out
/// (130215/130216). A mapping table says so; a function pretending they are
/// symmetric would not.
model BiologicalAssetStageAccount {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  speciesKey String @map("species_key")
  /// Matches `LivestockGroup.stage` exactly — the product's own vocabulary,
  /// not the workbook's.
  stage      String

  glAccountId String @map("gl_account_id") @db.Uuid

  active Boolean @default(true)

  company   Company   @relation(fields: [companyId], references: [id])
  glAccount GLAccount @relation("BiologicalStageAccount", fields: [glAccountId], references: [id])

  @@unique([companyId, speciesKey, stage])
  @@map("biological_asset_stage_accounts")
}

/// Company policy this posting needs and the workbook does not state a figure
/// for. See the file-level note above.
model BiologicalAssetConfiguration {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// §67.4's "threshold test". A single day's mortality for one population
  /// above this share is ABNORMAL and requires investigation; at or below it
  /// is NORMAL and posts as a fair-value loss without one.
  abnormalMortalityThresholdPercent Decimal @default(2) @map("abnormal_mortality_threshold_percent") @db.Decimal(9, 6)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("biological_asset_configurations")
}

/// One IAS 41 fair-value-less-costs-to-sell event (§61.3, §61.6, PCR-046/047).
///
/// Maker-checker through the same WorkflowTransaction engine every other
/// posting document uses — Rule 2 forbids a second approval mechanism, and a
/// valuation is exactly the kind of number (§61.6: "Farm Accountant /
/// Financial Controller") that must not post on one person's say-so.
model BiologicalAssetValuation {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid

  /// The stage the group was in when this was raised. Snapshotted because a
  /// stage transfer between raising and approving must not silently move
  /// which account an already-drafted valuation posts to.
  stage         String
  valuationDate DateTime @map("valuation_date") @db.Date

  openingQuantity Int @map("opening_quantity")
  closingQuantity Int @map("closing_quantity")

  /// The carrying value per unit this valuation started from — usually the
  /// group's own `currentFvlctsPerUnitKobo` at the time, captured so a later
  /// valuation's gain/loss is provably against what this one left behind.
  priorFvlctsPerUnitKobo BigInt @map("prior_fvlcts_per_unit_kobo")

  marketPricePerUnitKobo   BigInt @map("market_price_per_unit_kobo")
  costsToSellPerUnitKobo   BigInt @map("costs_to_sell_per_unit_kobo")
  /// = market price − costs to sell (formula 2). Stored rather than only
  /// computed, so a later change to either input cannot rewrite history.
  currentFvlctsPerUnitKobo BigInt @map("current_fvlcts_per_unit_kobo")

  direction    ValuationDirection @map("direction")
  gainLossKobo BigInt             @map("gain_loss_kobo")

  /// §61.6 blocking control: "approved market evidence and costs-to-sell
  /// required." A reference to what was approved — a price list, a buyer
  /// quotation — not the evidence itself.
  evidenceReference String @map("evidence_reference")

  status                WorkflowStatus @default(DRAFT)
  workflowTransactionId String?        @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String?        @map("journal_entry_id") @db.Uuid

  preparedById String   @map("prepared_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  company             Company              @relation(fields: [companyId], references: [id])
  group               LivestockGroup       @relation(fields: [groupId], references: [id])
  workflowTransaction WorkflowTransaction? @relation(fields: [workflowTransactionId], references: [id])
  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  preparedBy          User                 @relation("ValuationPreparer", fields: [preparedById], references: [id])

  @@index([companyId, groupId, valuationDate])
  @@map("biological_asset_valuations")
}

/// A governed market price for one species/breed, effective-dated the same
/// way `ItemStandardCost` is (§5, recipe.service.ts's `standardCostOn`):
/// setting a new price closes the previous row rather than overwriting it, so
/// a past valuation's evidence stays reproducible against what applied then.
///
/// Read by the valuation form to PREFILL its market price / cost-to-sell
/// fields — §61.6 still requires the preparer's own evidence reference and
/// still lets them override both numbers. This governs where the default
/// comes from; it does not remove the human judgement §61.6 requires.
model MarketPriceList {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  speciesKey String @map("species_key")
  /// Matches LivestockGroup.breed / SpeciesBreed.name.
  breed      String

  marketPricePerUnitKobo BigInt @map("market_price_per_unit_kobo")
  costsToSellPerUnitKobo BigInt @default(0) @map("costs_to_sell_per_unit_kobo")
  evidenceReference      String @map("evidence_reference")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([companyId, speciesKey, breed, effectiveFrom])
  @@map("market_price_lists")
}

// ---------------------------------------------------------------------------
// Fixed Assets (US-897-025)
//
// Account numbers below (1701/1702/5501) are additive to the current,
// actually-provisioned four-digit chart — see ProvisioningService.ACCOUNTS —
// not the client's own six-digit spec chart (posting-control.json PCR-029/
// 030/031 name 140100/149100/630100). That six-digit migration is a separate,
// still-unresolved client decision; these numbers are provisional pending it,
// the same disclosed-provisional pattern already used for the posting-control
// keys and the approval-ladder thresholds.
// ---------------------------------------------------------------------------

enum DepreciationMethod {
  STRAIGHT_LINE
}

model FixedAsset {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  assetNumber String @map("asset_number")
  name        String
  /// Free text — "Vehicle", "Machinery", "Building" — not a governed master
  /// yet; the spec's own PCR-029 basis names class as a required dimension,
  /// not a controlled list.
  assetClass  String @map("asset_class")

  acquisitionDate  DateTime           @map("acquisition_date") @db.Date
  /// MONEY. Landed cost at capitalisation (PCR-029: "landed cost meeting
  /// capitalisation policy").
  costKobo         BigInt             @map("cost_kobo")
  usefulLifeMonths Int                @map("useful_life_months")
  method           DepreciationMethod @default(STRAIGHT_LINE)

  costCentreId String? @map("cost_centre_id") @db.Uuid

  /// MONEY. Running balance — the sum of every posted DepreciationEntry
  /// against this asset. Denormalised so the register doesn't need to sum
  /// entries to show a book value.
  accumulatedDepreciationKobo BigInt @default(0) @map("accumulated_depreciation_kobo")

  /// The capitalisation's own approval pipeline — DRAFT through POSTED, the
  /// same shared enum every other document type here uses. Whether the asset
  /// is currently in service is a separate question, answered by
  /// `disposedOn`: null means active, set means disposed.
  status     WorkflowStatus @default(DRAFT)
  disposedOn DateTime?      @map("disposed_on") @db.Date

  /// Opaque to the workflow engine, same convention as every other document
  /// type here — a bare id, not a Prisma relation (see PurchaseOrder).
  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company             Company             @relation(fields: [companyId], references: [id])
  costCentre          CostCentre?         @relation(fields: [costCentreId], references: [id])
  journalEntry        JournalEntry?       @relation("FixedAssetCapitalisationJournal", fields: [journalEntryId], references: [id])
  createdBy           User                @relation("FixedAssetCapitaliser", fields: [createdById], references: [id])
  depreciationEntries DepreciationEntry[]

  @@unique([companyId, assetNumber])
  @@index([companyId, status])
  @@map("fixed_assets")
}

/// One depreciation run per company per period — the unique constraint is
/// what stops a run from posting the same period twice, mirroring
/// PayrollRun's one-run-per-month shape: many assets, one journal.
model DepreciationRun {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  financialPeriodId String         @map("financial_period_id") @db.Uuid
  status            WorkflowStatus @default(DRAFT)

  /// MONEY. Sum of every entry's amountKobo — the amount the workflow routes
  /// on and the journal posts.
  totalAmountKobo BigInt @default(0) @map("total_amount_kobo")

  workflowTransactionId String? @map("workflow_transaction_id") @db.Uuid
  journalEntryId        String? @map("journal_entry_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  postedAt    DateTime? @map("posted_at")

  company         Company             @relation(fields: [companyId], references: [id])
  financialPeriod FinancialPeriod     @relation(fields: [financialPeriodId], references: [id])
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  createdBy       User                @relation("DepreciationRunCreator", fields: [createdById], references: [id])
  entries         DepreciationEntry[]

  @@unique([companyId, financialPeriodId])
  @@map("depreciation_runs")
}

/// One line per asset within a run — this period's straight-line charge and
/// the asset it belongs to.
model DepreciationEntry {
  id      String @id @default(uuid()) @db.Uuid
  runId   String @map("run_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  /// MONEY.
  amountKobo BigInt @map("amount_kobo")

  run   DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset FixedAsset      @relation(fields: [assetId], references: [id])

  @@unique([runId, assetId])
  @@map("depreciation_entries")
}

// ---------------------------------------------------------------------------
// KPI definitions (US-897-034) — the nine KPIs `KpiService` computes are real
// code, not registry data; this is the governance layer the story's own
// first criterion asks for: each KPI's meaning as an inspectable row, not
// only a code comment nobody outside this repo can read. Deliberately NOT a
// formula-language engine — `formula` is a human-readable description of
// what `KpiService` actually does, kept honest by construction (seeded
// straight from that file's own doc comments, not invented), not a second
// computation path that could drift from the real one.
/// One governed definition per KPI this company's engine computes.
model KpiDefinition {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Matches `Kpi.key` in kpi.service.ts (e.g. "yield", "survivalRate").
  key   String
  label String

  numerator   String
  denominator String?
  /// Human-readable description of the computation — not an executable
  /// expression. The one true formula is `KpiService`'s own code; this
  /// exists so a reader doesn't have to open the repo to know what it does.
  formula String

  /// Where this KPI is actually computed — a file:method pointer, so
  /// "governed data" never drifts silently out of sync with the real logic.
  source String

  /// Which filter dimensions this KPI currently honours, e.g.
  /// ["farm","period","batch"] — an empty array means company-wide only,
  /// which is itself real information (not every KPI can be scoped, and
  /// pretending otherwise would be worse than an honest empty list).
  dimensions String[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("kpi_definitions")
}

// ---------------------------------------------------------------------------
// Report catalogue (US-897-033) — the report index page has always been a
// hardcoded array in the web app (deliberately, until now: nothing consumed
// governed report metadata, so a database-driven catalogue would have been
// scope invented ahead of any need). KpiDefinition established the pattern
// this criterion itself asks for; this is the report-level equivalent —
// purpose/owner/frequency/source/filters/measures as real, inspectable rows,
// and the web app's own reports index now reads them instead of its old
// static array, so the "consumer" this was waiting on is real, not notional.
/// One governed definition per report this company can run.
model ReportDefinition {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  /// Stable slug, e.g. "trial-balance". Matches the web route's own segment.
  key  String
  name String

  purpose String
  /// The role accountable for this report existing/being right — not who is
  /// merely allowed to view it (that's the endpoint's own @Roles() guard).
  owner String
  /// Free text, e.g. "On demand", "Monthly close" — not an enum, since the
  /// client's own cadence for each report was never specified as a fixed set.
  frequency String

  /// Where the figures actually come from — a file:method pointer, so this
  /// row can never claim a computation the code doesn't actually do.
  source String

  /// Query params the report's own endpoint actually accepts.
  filters String[]
  /// What each row/figure in the report actually represents.
  measures String[]

  /// The web route this report lives at, e.g. "/ledger/trial-balance".
  webPath String @map("web_path")
  /// The read endpoint itself, e.g. "GET /reporting/trial-balance".
  apiEndpoint String @map("api_endpoint")

  exportSupported       Boolean @default(false) @map("export_supported")
  drillThroughSupported Boolean @default(false) @map("drill_through_supported")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("report_definitions")
}
