  @@unique([companyId, code])
  @@map("departments")
}

/// Self-referencing hierarchy. Consolidated Reference §1.2.
model CostCentre {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  code          String
  name          String
  parentId      String?   @map("parent_id") @db.Uuid
  managerName   String?   @map("manager_name")
  departmentId  String?   @map("department_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  active        Boolean   @default(true)
  effectiveDate DateTime  @map("effective_date") @db.Date
  closingDate   DateTime? @map("closing_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id])
  parent               CostCentre?           @relation("CostCentreHierarchy", fields: [parentId], references: [id])
  children             CostCentre[]          @relation("CostCentreHierarchy")
  department           Department?           @relation(fields: [departmentId], references: [id])
  branch               Branch?               @relation(fields: [branchId], references: [id])
  journalLines         JournalLine[]
  workflowDefinitions  WorkflowDefinition[]
  workflowTransactions WorkflowTransaction[]
  supplierDefaults     Supplier[]            @relation("SupplierCostCentre")
  customerDefaults     Customer[]            @relation("CustomerCostCentre")
  employees            Employee[]            @relation("EmployeeCostCentre")
  manualJournalLines   ManualJournalLine[]
  payrollRunLines      PayrollRunLine[]      @relation("PayrollLineCostCentre")
  salesQuotations      SalesQuotation[]      @relation("QuotationCostCentre")
  salesOrders          SalesOrder[]          @relation("SalesOrderCostCentre")
  salesInvoices        SalesInvoice[]        @relation("InvoiceCostCentre")
  purchaseRequisitions PurchaseRequisition[] @relation("RequisitionCostCentre")
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderCostCentre")
  supplierInvoices     SupplierInvoice[]     @relation("SupplierInvoiceCostCentre")
  fixedAssets          FixedAsset[]

  @@unique([companyId, code])
  @@index([parentId])
  @@map("cost_centres")
}

// ---------------------------------------------------------------------------
// Chart of Accounts
// ---------------------------------------------------------------------------

/// Consolidated Reference §1.3. The `requires*` flags are what make
/// "cost centre is mandatory by account" configuration rather than code —
/// the DimensionValidator reads them at posting time.
model GLAccount {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  accountNumber    String        @map("account_number")
  name             String
  accountType      AccountType   @map("account_type")
  normalBalance    NormalBalance @map("normal_balance")
  parentId         String?       @map("parent_id") @db.Uuid
  /// Only posting accounts may appear on a journal line. Summary/parent
  /// accounts exist for reporting rollup and are rejected by the poster.
  isPostingAccount Boolean       @default(true) @map("is_posting_account")
  active           Boolean       @default(true)

  requiresCostCentre Boolean @default(false) @map("requires_cost_centre")
  requiresDepartment Boolean @default(false) @map("requires_department")
  requiresFarm       Boolean @default(false) @map("requires_farm")
  requiresProject    Boolean @default(false) @map("requires_project")

  /// US-897-002. Nullable: an unclassified account is exactly that, not
  /// silently defaulted to a category nobody chose. `fsCategorySetAt` is
  /// when this classification was last set — a timestamp, not an
  /// effective-dated range: unlike a standard cost, a past journal line was
  /// never computed FROM an account's FS category, so there is nothing that
  /// needs to resolve "which category applied as of that date" the way
  /// ItemStandardCost does. What changed and when is retained instead
  /// through the ordinary audit trail (AuditService), on every set.
  fsCategory      FsCategory? @map("fs_category")
  fsCategorySetAt DateTime?   @map("fs_category_set_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                      Company                       @relation(fields: [companyId], references: [id])
  parent                       GLAccount?                    @relation("GLAccountHierarchy", fields: [parentId], references: [id])
  children                     GLAccount[]                   @relation("GLAccountHierarchy")
  journalLines                 JournalLine[]
  taxGlMappings                TaxGLMapping[]
  itemsInventoryDefault        Item[]                        @relation("ItemInventoryAccount")
  itemsExpenseDefault          Item[]                        @relation("ItemExpenseAccount")
  itemsRevenueDefault          Item[]                        @relation("ItemRevenueAccount")
  salaryComponentExpense       SalaryComponent[]             @relation("SalaryComponentExpense")
  salaryComponentPayable       SalaryComponent[]             @relation("SalaryComponentPayable")
  manualJournalLines           ManualJournalLine[]
  recurringJournalLines        RecurringJournalLine[]
  salesReceivableConfigs       SalesConfiguration[]          @relation("SalesReceivableAccount")
  salesRevenueConfigs          SalesConfiguration[]          @relation("SalesRevenueAccount")
  salesCostOfSalesConfigs      SalesConfiguration[]          @relation("SalesCostOfSalesAccount")
  salesInventoryConfigs        SalesConfiguration[]          @relation("SalesInventoryAccount")
  salesWhtReceivableConfigs    SalesConfiguration[]          @relation("SalesWhtReceivableAccount")
  receiptBankAccounts          CustomerReceipt[]             @relation("ReceiptBankAccount")
  procurementGrniConfigs       ProcurementConfiguration[]    @relation("ProcurementGrniAccount")
  procurementPayablesConfigs   ProcurementConfiguration[]    @relation("ProcurementPayablesAccount")
  procurementWhtConfigs        ProcurementConfiguration[]    @relation("ProcurementWhtPayableAccount")
  supplierInvoiceLineCosts     SupplierInvoiceLine[]         @relation("SupplierInvoiceLineCostAccount")
  paymentBankAccounts          SupplierPayment[]             @relation("PaymentBankAccount")
  payrollPaymentBankAccounts   PayrollPayment[]
  accountBalances              AccountBalance[]
  postingKeys                  PostingKey[]                  @relation("PostingKeyAccount")
  biologicalAssetStageAccounts BiologicalAssetStageAccount[] @relation("BiologicalStageAccount")

  @@unique([companyId, accountNumber])
  @@index([parentId])
  @@map("gl_accounts")
}

// ---------------------------------------------------------------------------
// Currency
// ---------------------------------------------------------------------------

model Currency {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  name           String
  /// Number of decimal places in the minor unit. NGN = 2 (kobo).
  /// Every amount in this system is an integer count of these minor units.
  minorUnitScale Int    @default(2) @map("minor_unit_scale")

  companies            Company[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  ratesFrom            ExchangeRate[]        @relation("RateFromCurrency")
  ratesTo              ExchangeRate[]        @relation("RateToCurrency")
  workflowDefinitions  WorkflowDefinition[]
  workflowTransactions WorkflowTransaction[]
  suppliers            Supplier[]
  customers            Customer[]
  manualJournals       ManualJournal[]
  recurringJournals    RecurringJournal[]
  payrollRuns          PayrollRun[]
  salesQuotations      SalesQuotation[]
  salesOrders          SalesOrder[]
  deliveryNotes        DeliveryNote[]
  salesInvoices        SalesInvoice[]
  customerReceipts     CustomerReceipt[]
  creditNotes          CreditNote[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceiptNotes    GoodsReceiptNote[]
  supplierInvoices     SupplierInvoice[]
  supplierPayments     SupplierPayment[]
  payrollPayments      PayrollPayment[]

  @@map("currencies")
}

/// Effective-dated. The posting service resolves the rate for the transaction
/// date; a caller-supplied rate is stored on the transaction and never
/// recalculated afterwards. No revaluation logic — the source documents do not
/// specify one, so none is invented (Rule 10).
model ExchangeRate {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  fromCurrencyId String    @map("from_currency_id") @db.Uuid
  toCurrencyId   String    @map("to_currency_id") @db.Uuid
  rate           Decimal   @db.Decimal(18, 8)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  company      Company  @relation(fields: [companyId], references: [id])
  fromCurrency Currency @relation("RateFromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("RateToCurrency", fields: [toCurrencyId], references: [id])

  @@index([companyId, fromCurrencyId, toCurrencyId, effectiveFrom])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Financial calendar
