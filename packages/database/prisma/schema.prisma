  treatmentRecords              TreatmentRecord[]
  harvestRecords                HarvestRecord[]
  stageChanges                  StageChange[]
  branches                      Branch[]
  departments                   Department[]
  costCentres                   CostCentre[]
  glAccounts                    GLAccount[]
  financialYears                FinancialYear[]
  farms                         Farm[]
  projects                      Project[]
  warehouses                    Warehouse[]
  exchangeRates                 ExchangeRate[]
  journalEntries                JournalEntry[]
  journalLines                  JournalLine[]
  workflowDefinitions           WorkflowDefinition[]
  workflowTransactions          WorkflowTransaction[]
  workflowDelegations           WorkflowDelegation[]
  workflowEscalationRules       WorkflowEscalationRule[]
  taxCodes                      TaxCode[]
  taxConfigurations             TaxConfiguration[]
  taxGlMappings                 TaxGLMapping[]
  taxPeriods                    TaxPeriod[]
  vatRegisterEntries            VatRegisterEntry[]
  whtRegisterEntries            WhtRegisterEntry[]
  taxAdjustments                TaxAdjustment[]
  paymentTerms                  PaymentTerm[]
  unitsOfMeasure                UnitOfMeasure[]
  suppliers                     Supplier[]
  customers                     Customer[]
  items                         Item[]
  employees                     Employee[]
  salaryComponents              SalaryComponent[]
  productRecipes                ProductRecipe[]
  journalTypes                  JournalType[]
  reasonCodes                   ReasonCode[]
  manualJournals                ManualJournal[]
  recurringJournals             RecurringJournal[]
  payeBands                     PayeBand[]
  payeConfigurations            PayeConfiguration[]
  statutoryConfigurations       StatutoryConfiguration[]
  payrollRuns                   PayrollRun[]
  salesConfigurations           SalesConfiguration[]
  stockMovements                StockMovement[]
  salesQuotations               SalesQuotation[]
  salesOrders                   SalesOrder[]
  deliveryNotes                 DeliveryNote[]
  salesInvoices                 SalesInvoice[]
  customerReceipts              CustomerReceipt[]
  creditNotes                   CreditNote[]
  salesReturns                  SalesReturn[]
  procurementConfigurations     ProcurementConfiguration[]
  purchaseRequisitions          PurchaseRequisition[]
  rfqs                          Rfq[]
  purchaseOrders                PurchaseOrder[]
  goodsReceiptNotes             GoodsReceiptNote[]
  supplierInvoices              SupplierInvoice[]
  supplierPayments              SupplierPayment[]
  closeChecklistTemplates       PeriodCloseChecklistTemplate[]
  periodCloseLogs               PeriodCloseLog[]
  accountBalances               AccountBalance[]
  periodReopenRequests          PeriodReopenRequest[]
  postingKeys                   PostingKey[]
  postingRules                  PostingRule[]
  biologicalAssetStageAccounts  BiologicalAssetStageAccount[]
  biologicalAssetConfigurations BiologicalAssetConfiguration[]
  biologicalAssetValuations     BiologicalAssetValuation[]
  fixedAssets                   FixedAsset[]
  depreciationRuns              DepreciationRun[]
  speciesBreeds                 SpeciesBreed[]
  marketPriceLists              MarketPriceList[]
  payrollPayments                PayrollPayment[]
  roleSectionAccess               RoleSectionAccess[]
  productionOrders               ProductionOrder[]
  inventoryTransfers              InventoryTransfer[]
