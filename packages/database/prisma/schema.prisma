  branch               Branch                @relation(fields: [branchId], references: [id])
  pens                 PenHouse[]
  livestockGroups      LivestockGroup[]
  journalLines         JournalLine[]
  workflowDefinitions  WorkflowDefinition[]
  workflowTransactions WorkflowTransaction[]
  manualJournalLines   ManualJournalLine[]
  salesQuotations      SalesQuotation[]
  salesOrders          SalesOrder[]
  salesInvoices        SalesInvoice[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  supplierInvoices     SupplierInvoice[]
  productionOrders     ProductionOrder[]

  @@unique([companyId, code])
  @@map("farms")
}

/// Snail pen or poultry house. Generic by design — the species lives in the
/// data, not the schema (Rule 8).
model PenHouse {
